[Unit]
Description=xray-omarchy: killswitch from boot, before the network comes up (nftables table inet xray-omarchy)
Documentation=file:/usr/lib/xray-omarchy/xray-omarchy-helper
# Loads the table only if the killswitch was on (/var/lib/xray-omarchy/killswitch); the user's
# xray-omarchy.service sets it again on start. Stopping this unit does not remove the table:
# `xray-omarchy off` does.
DefaultDependencies=no
After=local-fs.target nftables.service
Before=network-pre.target shutdown.target
Wants=network-pre.target
Conflicts=shutdown.target
ConditionPathExists=/var/lib/xray-omarchy/killswitch

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/xray-omarchy/xray-omarchy-helper killswitch boot

[Install]
WantedBy=multi-user.target
