def main():
    p = argparse.ArgumentParser(prog=NAME, description=__doc__.split("\n")[0])
    p.add_argument("--version", action="version", version="%(prog)s " + VERSION)
    sp = p.add_subparsers(dest="cmd")
    s = sp.add_parser("status", help="state")
    s.add_argument("--json", action="store_true")
    s.add_argument("--nodes", action="store_true", help="with the node list and delays")
    s.add_argument("--refresh", action="store_true", help="re-check the exit address")
    s = sp.add_parser("on", help="bring the tunnel up")
    s.add_argument("--json", action="store_true", help="result as one JSON {ok, code, detail}")
    s = sp.add_parser("off", help="take the tunnel down, direct exit")
    s.add_argument("--json", action="store_true", help="result as one JSON {ok, code, detail}")
    s = sp.add_parser("select", help="select a node by id, or auto")
    s.add_argument("node")
    s.add_argument("--json", action="store_true", help="result as one JSON {ok, code, detail}")
    s = sp.add_parser("use", help="make a subscription active (xray-omarchy use -- NAME)")
    s.add_argument("name")
    s.add_argument("--json", action="store_true", help="result as one JSON {ok, code, detail}")
    s = sp.add_parser("update", help="update subscriptions")
    s.add_argument("--name")
    s.add_argument("--apply", action="store_true", help="restart the core if the active one changed")
    s.add_argument("--json", action="store_true", help="per-subscription result as one JSON")
