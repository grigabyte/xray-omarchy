                                       ("ok, %s ms, %s" % (r.get("ms"), site_way(r)) if r.get("ok")
                                        else "FAIL, %s, %s" % (site_error_text(r), site_way(r)))))
    return 0


def cmd_trim(args):
    """Every few minutes from a timer: accumulates traffic and keeps the logs in tmpfs from growing."""
    if service_active():
        account_traffic(metrics())
    for path, keep in ((ACCESS_LOG, 3000), (ERROR_LOG, 500)):
        try:
            if os.path.getsize(path) > 2_000_000:
                lines = tail(path, keep, max_bytes=1_000_000)
                # The core writes with O_APPEND, so truncating in place is safe.
                with open(path, "r+", encoding="utf8") as fh:
                    fh.truncate(0)
                with open(path, "a", encoding="utf8") as fh:
                    fh.write("\n".join(lines) + "\n")
        except OSError:
            pass
    return 0


