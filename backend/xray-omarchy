def apply_change(args, selection, nodes, text):
    """Save the choice, rebuild the config and apply it live; a restart
    only with --apply (the panel asks for confirmation)."""
    write_json(SELECTION_FILE, selection)
    cmd_build(None)
    if not service_active():
        return finish(args, True, "", "", text + " (core is not running, applies on start)")
    need = restart_needed(selection, nodes)
    if need and getattr(args, "apply", False):
        run(["systemctl", "--user", "restart", UNIT], timeout=60)
        return finish(args, True, "restarted", "", text + "; core restarted")
    if not push_rules(selection, nodes):
        return finish(args, False, "apply_failed", "live rules were not accepted",
                      text + "; saved, but the running core did not accept the rules (applies on restart)")
    if need:
        return finish(args, True, "restart_needed", "node probing interval changes on core restart",
                      text + "; probing interval changes on core restart: run again with --apply")
    return finish(args, True, "", "", text + " (no restart)")


def cmd_fallback(args):
    subs, selection, sid, nodes = active_nodes()
    by_id = {n["id"]: n for n in nodes}
    fb = dict(selection.get("fallback") or {"enabled": False, "node": None})
    if args.action == "set":
        if not args.node or args.node not in by_id or by_id[args.node]["kind"] != "node":
            return finish(args, False, "fallback_not_found", args.node or "",
                          "node %s is not a plain node of the active subscription" % args.node)
        if selection.get("mode") == "node" and args.node == selection.get("node"):
            return finish(args, False, "same_node", args.node,
                          "the fallback node must differ from the selected one")
        fb["node"] = args.node
        selection["fallback"] = fb
        if not fb.get("enabled"):
            write_json(SELECTION_FILE, selection)
            return finish(args, True, "", "", "fallback node: %s (fallback is off)" % by_id[args.node]["name"])
        return apply_change(args, selection, nodes, "fallback node: %s" % by_id[args.node]["name"])
    if args.action == "on":
        problem = fallback_problem(dict(selection, fallback=fb), nodes)
        if problem:
            text = {"not_node_mode": "fallback works only with a manually selected node",
                    "primary_not_node": "the selected entry is a group, not a node",
                    "no_fallback_node": "no fallback node set: xray-omarchy fallback set ID",
                    "fallback_not_found": "the fallback node is not in the active subscription",
                    "same_node": "the fallback node must differ from the selected one"}[problem]
            return finish(args, False, problem, "", text)
        fb["enabled"] = True
        selection["fallback"] = fb
        return apply_change(args, selection, nodes, "fallback on: %s" % by_id[fb["node"]]["name"])
    fb["enabled"] = False
    selection["fallback"] = fb
    return apply_change(args, selection, nodes, "fallback off")


def balancer_pick(tag="auto"):
    """(whether the core answered, the selected tag). An empty choice in pinned means the
    primary is not alive and traffic goes to fallbackTag."""
    r = run([XRAY, "api", "bi", "--server=" + API, tag], timeout=5)
    if r.returncode != 0 or "Selects:" not in r.stdout:
        return False, None
    m = re.search(r"Selects:\s*\n\s*\d+\s+(\S+)", r.stdout)
    return True, (m.group(1) if m else None)


def fallback_status(selection, nodes, running, with_restart=True):
    fb = selection.get("fallback") or {}
    by_id = {n["id"]: n for n in nodes}
    pair = fallback_pair(selection, nodes)
    out = {"enabled": bool(fb.get("enabled")), "node": fb.get("node"),
           "node_name": by_id[fb["node"]]["name"] if fb.get("node") in by_id else None,
           "active": False, "ready": bool(pair),
           "problem": fallback_problem(selection, nodes) if fb.get("enabled") else None,
           "restart_needed": restart_needed(selection, nodes) if running and with_restart else False,
           "pick": None}
    if pair and running:
        answered, pick = balancer_pick("pinned")
        if not answered:
            out["active"] = None  # the core does not know pinned (not applied yet)
        else:
            out["pick"] = pick
            out["active"] = pick != pair[0]["target"]
    return out


