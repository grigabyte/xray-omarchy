    s.add_argument("action", choices=["list", "add", "rm"])
    s.add_argument("name", nargs="?")
    s.add_argument("url", nargs="?")
    s.add_argument("--ua")
    s.add_argument("--allow-http", action="store_true",
                   help="add: accept a plain http:// link (anyone on the way reads and can swap the nodes)")
    s.add_argument("--json", action="store_true", help="add/rm: result as one JSON {ok, code, detail}")
    sp.add_parser("build", help="build the core config")
    s = sp.add_parser("net", help="routes into the TUN: up | down")
    s.add_argument("action", choices=["up", "down"])
    s = sp.add_parser("fw", help="killswitch (nftables table inet xray-omarchy): on | off")
    s.add_argument("action", choices=["on", "off"])
    s = sp.add_parser("dns", help="system DNS: on (core) | off (router)")
    s.add_argument("action", choices=["on", "off"])
    sp.add_parser("trim", help="internal: traffic accounting and log trimming")
    s = sp.add_parser("preset", help="direct presets: list | russia on|off [--apply]")
    s.add_argument("name", choices=["list"] + sorted(PRESETS))
    s.add_argument("action", nargs="?", choices=["on", "off"])
    s.add_argument("--apply", action="store_true", help="restart the core if it is running")
    s.add_argument("--json", action="store_true", help="result as one JSON {ok, code, detail}")
    s = sp.add_parser("fallback", help="fallback node: set ID | on | off [--apply]")
    s.add_argument("action", choices=["set", "on", "off"])
    s.add_argument("node", nargs="?")
    s.add_argument("--apply", action="store_true", help="restart the core if the change needs it")
    s.add_argument("--json", action="store_true", help="result as one JSON {ok, code, detail}")
    s = sp.add_parser("rule", help="site rules: add direct|tunnel HOST | rm HOST | list")
    s.add_argument("action", choices=["add", "rm", "list"])
    s.add_argument("side", nargs="?", help="direct|tunnel for add; HOST for rm")
    s.add_argument("host", nargs="?")
    s.add_argument("--json", action="store_true")
    s = sp.add_parser("notify", help="desktop notifications: on | off | status")
    s.add_argument("action", choices=["on", "off", "status"], nargs="?", default="status")
    s.add_argument("--json", action="store_true")
    s = sp.add_parser("site", help="sites to check: list | add NAME URL | rm NAME | check | notify on|off")
    s.add_argument("action", choices=["list", "add", "rm", "check", "notify"])
    s.add_argument("name", nargs="?", help="NAME for add and rm; on|off for notify")
    s.add_argument("url", nargs="?", help="add: an https link")
    s.add_argument("--json", action="store_true",
                   help="add/rm/notify: result as one JSON {ok, code, detail}; list/check: the data as JSON")
    s = sp.add_parser("watch", help="notify about tunnel events (service xray-omarchy-watch)")
    s.add_argument("--once", action="store_true", help="one poll, print events, exit")
    s.add_argument("--json", action="store_true", help="with --once: events as JSON")
    s.add_argument("--state-file", help="test: read this JSON instead of the live state")
    s.add_argument("--memory", help="test: dedup memory file (default next to --state-file)")
    s = sp.add_parser("core", help="xray core: status | update [--to VERSION] [--dry-run]")
    s.add_argument("action", choices=["status", "update", "install"])
    s.add_argument("target", nargs="?", help=argparse.SUPPRESS)
    s.add_argument("--to", help="update: this pinned version instead of the newest pinned one")
    s.add_argument("--json", action="store_true")
    s.add_argument("--refresh", action="store_true", help="status: re-check GitHub now")
    s.add_argument("--dry-run", action="store_true", help="update: download, verify, test; do not install")
    s.add_argument("--force", action="store_true", help="update: reinstall even if the version is not newer")
    s.add_argument("--from-version", help=argparse.SUPPRESS)
    args = p.parse_args()
    handlers = {"status": cmd_status, "on": cmd_on, "off": cmd_off, "select": cmd_select, "use": cmd_use,
                "update": cmd_update, "sub": cmd_sub, "build": cmd_build, "net": cmd_net, "fw": cmd_fw,
                "dns": cmd_dns, "trim": cmd_trim, "preset": cmd_preset, "fallback": cmd_fallback,
                "rule": cmd_rule, "notify": cmd_notify, "site": cmd_site, "watch": cmd_watch, "core": cmd_core}
    if not args.cmd:
        args = p.parse_args(["status"])
    if args.cmd == "core" and args.action == "install" and not args.target:
        p.error("core install needs a version")
    return handlers[args.cmd](args)


if __name__ == "__main__":
    sys.exit(main())
