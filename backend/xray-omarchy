def read_limited(resp, limit):
    """The body of a response, refused when it is larger than limit bytes."""
    body = resp.read(limit + 1)
    if len(body) > limit:
        raise ValueError("response larger than %d MiB" % (limit >> 20) if limit >= 1 << 20
                         else "response larger than %d bytes" % limit)
    return body


class NoDowngrade(urllib.request.HTTPRedirectHandler):
    """Redirects only to https: an https subscription never ends up fetched in
    plain text (urllib follows https -> http by default)."""

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        if up.urlsplit(newurl).scheme != "https":
            raise urllib.error.HTTPError(newurl, code, "redirect to a non-https link refused (insecure_url)",
                                         headers, fp)
        return super().redirect_request(req, fp, code, msg, headers, newurl)


def insecure_sub(sub):
    """A plain-http subscription not explicitly allowed (sub add --allow-http)."""
    return up.urlsplit(sub["url"]).scheme != "https" and not sub.get("allow_http")


def fetch_sub(sub):
    if insecure_sub(sub):
        raise ValueError("insecure_url: the link is plain http; add it again with --allow-http to accept that")
    req = urllib.request.Request(sub["url"], headers={"User-Agent": sub.get("ua") or DEFAULT_UA})
    opener = urllib.request.build_opener() if sub.get("allow_http") else urllib.request.build_opener(NoDowngrade)
    with opener.open(req, timeout=30) as resp:
        body = read_limited(resp, SUB_MAX)
        headers = {k.lower(): v for k, v in resp.headers.items()}
    return body, headers


def parse_userinfo(value):
    out = {}
    for part in (value or "").split(";"):
        if "=" in part:
            k, v = part.split("=", 1)
            try:
                out[k.strip()] = int(float(v.strip()))
            except ValueError:
                pass
    return out


def profile_title(value):
    if not value:
        return None
    if value.startswith("base64:"):
        return b64decode_loose(value[7:])
    return value


def cmd_update(args):
    subs = load_subs()
    if not subs:
        say("no subscriptions: xray-omarchy sub add NAME URL")
        if args.json:
            print("[]")
        return 0
    selection = read_json(SELECTION_FILE, {})
    active_changed = False
    failed = 0
    results = []
    for sub in subs:
        if args.name and sub["name"] != args.name:
            continue
        sid = sub_id(sub)
        try:
            body, headers = fetch_sub(sub)
            nodes, skipped = parse_subscription(body, sid)
            if not nodes:
                raise ValueError("no usable nodes in response (skipped: %s)" % (
                    ", ".join("%s%s ×%d" % (i["scheme"] + " " if i["scheme"] else "", i["code"], i["count"])
                              for i in skipped) or "-"))
        except Exception as error:
            failed += 1
            results.append({"name": sub["name"], "ok": False, "error": str(error)[:200]})
            if not args.json:
                say("%s: not updated (%s), keeping the previous copy" % (sub["name"], error))
            else:
                log("%s: not updated (%s)" % (sub["name"], error))
            continue
        raw_path = os.path.join(SUBS_CACHE, sid + ".raw")
        old = None
        if os.path.exists(raw_path):
            with open(raw_path, "rb") as fh:
                old = fh.read()
        write_private(raw_path, body, binary=True)
        meta = {
            "name": sub["name"],
            "updated": int(time.time()),
            "userinfo": parse_userinfo(headers.get("subscription-userinfo")),
            "title": profile_title(headers.get("profile-title")),
            "count": len(nodes),
            "skipped": skipped,
        }
        write_json(os.path.join(SUBS_CACHE, sid + ".meta.json"), meta)
        results.append({"name": sub["name"], "ok": True, "count": len(nodes), "skipped": skipped})
        line = "%s: %d nodes%s" % (sub["name"], len(nodes),
                                   ", skipped: " + ", ".join(skip_text(skipped)) if skipped else "")
        say(line) if not args.json else log(line)
        if old != body and active_sub_id(selection, subs) == sid:
            active_changed = True
    if args.apply and active_changed and service_active():
        say("active subscription changed: rebuilding the config and restarting the core")
        restart_core()
    if args.json:
        print(json.dumps(results, ensure_ascii=False))
    # Non-zero exit if any one failed to update: the panel and the timer must see it.
    return 1 if failed else 0


def cmd_sub(args):
    subs = load_subs()
    if args.action == "list":
        selection = read_json(SELECTION_FILE, {})
        active = active_sub_id(selection, subs)
        for sub in subs:
            meta = read_json(os.path.join(SUBS_CACHE, sub_id(sub) + ".meta.json"), {})
            mark = "*" if sub_id(sub) == active else " "
            print("%s %-20s nodes %-4s updated %s" % (
                mark, sub["name"], meta.get("count", "-"),
                time.strftime("%F %H:%M", time.localtime(meta["updated"])) if meta.get("updated") else "never"))
        return 0
    if args.action == "add":
        if not args.name or not args.url:
            return finish(args, False, "usage", "", "usage: xray-omarchy sub add NAME URL")
        name = args.name.strip()
        if not SUB_NAME_RE.fullmatch(name):
            return finish(args, False, "invalid_name", "",
                          "subscription name: 1-40 characters, no control characters, not starting with -")
        url = args.url.strip()
        parsed = up.urlsplit(url)
        if parsed.scheme not in ("https", "http") or not parsed.hostname or any(c.isspace() for c in url):
            return finish(args, False, "invalid_url", "", "subscription URL must be an http(s) link")
        if parsed.scheme == "http" and not args.allow_http:
            return finish(args, False, "insecure_url", "",
                          "not added: the link is plain http — anyone on the way can read it and swap the "
                          "nodes. Use https, or add it with --allow-http if you accept that")
        exists = any(s["name"] == name for s in subs)
        subs = [s for s in subs if s["name"] != name]
        entry = {"name": name, "url": url}
        if args.ua:
            entry["ua"] = args.ua
        if parsed.scheme == "http":
            entry["allow_http"] = True
            say("warning: %s is fetched over plain http: its nodes can be read and swapped on the way" % name)
        subs.append(entry)
        write_json(SUBS_FILE, subs)
        return finish(args, True, "replaced" if exists else "", name,
                      "subscription %s %s" % (name, "replaced" if exists else "added"))
    if args.action == "rm":
        left = [s for s in subs if s["name"] != args.name]
        if len(left) == len(subs):
            return finish(args, False, "not_found", args.name or "", "no subscription %s" % args.name)
        write_json(SUBS_FILE, left)
        return finish(args, True, "", args.name, "subscription %s removed" % args.name)
    return 2


# Shown in the panel and passed as one argv entry; never parsed as an option.
SUB_NAME_RE = re.compile(r"(?!-)[^\x00-\x1f\x7f]{1,40}")


# ---------------------------------------------------------------- parsing nodes

class Unsupported(Exception):
    """The node is understood, but it will not be connected; the argument is the reason code."""


# Skip reasons go out as codes: the panel puts the labels on them, this is the terminal text.
SKIP_TEXT = {
    "insecure_tls": "TLS without certificate check",
    "hy2_obfs": "hysteria2 with obfs",
    "parse_error": "parse error",
    "unsupported_scheme": "unsupported protocol",
    "loopback_profile": "profiles with loopback",
    "no_group": "profiles without a group",
    "no_node": "profiles without a node",
    "clash_format": "clash (yaml) format, a v2ray-format link is needed",
}


def add_skip(skipped, code, scheme=""):
    skipped[(code, scheme)] = skipped.get((code, scheme), 0) + 1


def skip_items(skipped):
    return [{"code": c, "scheme": s, "count": n} for (c, s), n in skipped.items()]


def skip_text(items):
    out = []
    for it in items or []:
        if isinstance(it, str):  # a cache from an earlier version
            out.append(it)
            continue
        text = SKIP_TEXT.get(it["code"], it["code"])
        out.append("%s%s ×%d" % (it["scheme"] + ": " if it.get("scheme") else "", text, it["count"]))
    return out


def insecure_tls(q, tls):
    """xray 26 dropped allowInsecure. Without a pinned certificate such a node
    can be intercepted by swapping the certificate, so it is not connected."""
    if q.get("allowInsecure") in ("1", "true") or q.get("insecure") in ("1", "true"):
        if not tls.get("pinnedPeerCertSha256"):
            raise Unsupported("insecure_tls")

def stream_from_query(q, host):
    net = (q.get("type") or "tcp").lower()
    if net == "raw":
        net = "tcp"
    if net == "splithttp":
        net = "xhttp"
    security = (q.get("security") or "none").lower()
    stream = {"network": net, "security": security}
    sni = q.get("sni") or q.get("peer") or ""
    fp = q.get("fp") or ""
    alpn = [a for a in (q.get("alpn") or "").split(",") if a]
    if security == "tls":
        tls = {"serverName": sni or host}
        if fp:
            tls["fingerprint"] = fp
        if alpn:
            tls["alpn"] = alpn
        if q.get("pcs"):
            tls["pinnedPeerCertSha256"] = q["pcs"]
        insecure_tls(q, tls)
        stream["tlsSettings"] = tls
    elif security == "reality":
        reality = {"serverName": sni, "fingerprint": fp or "chrome",
                   "publicKey": q.get("pbk", ""), "shortId": q.get("sid", "")}
        if q.get("spx"):
            reality["spiderX"] = q["spx"]
        if q.get("pqv"):
            reality["mldsa65Verify"] = q["pqv"]
        stream["realitySettings"] = reality
    path = q.get("path")
    hhost = q.get("host")
    if net == "ws":
        stream["wsSettings"] = {"path": path or "/", **({"host": hhost} if hhost else {})}
    elif net == "httpupgrade":
        stream["httpupgradeSettings"] = {"path": path or "/", **({"host": hhost} if hhost else {})}
    elif net == "grpc":
        grpc = {"serviceName": q.get("serviceName", ""), "multiMode": q.get("mode") == "multi"}
        if q.get("authority"):
            grpc["authority"] = q["authority"]
        stream["grpcSettings"] = grpc
    elif net == "xhttp":
        xh = {"path": path or "/", "mode": q.get("mode") or "auto"}
        if hhost:
            xh["host"] = hhost
        if q.get("extra"):
            try:
                xh["extra"] = json.loads(q["extra"])
            except ValueError:
                pass
        stream["xhttpSettings"] = xh
    elif net == "tcp" and q.get("headerType") == "http":
        stream["tcpSettings"] = {"header": {"type": "http", "request": {
            "path": [path or "/"], "headers": {"Host": [hhost]} if hhost else {}}}}
    elif net == "kcp":
        stream["kcpSettings"] = {"header": {"type": q.get("headerType") or "none"},
                                 **({"seed": q["seed"]} if q.get("seed") else {})}
    return stream


def parse_vless(link):
    u = up.urlsplit(link)
    q = dict(up.parse_qsl(u.query))
    user = {"id": up.unquote(u.username or ""), "encryption": q.get("encryption") or "none"}
    if q.get("flow"):
        user["flow"] = q["flow"]
    return {"protocol": "vless",
            "settings": {"vnext": [{"address": u.hostname, "port": u.port, "users": [user]}]},
            "streamSettings": stream_from_query(q, u.hostname)}


def parse_trojan(link):
    u = up.urlsplit(link)
    q = dict(up.parse_qsl(u.query))
    q.setdefault("security", "tls")
    return {"protocol": "trojan",
            "settings": {"servers": [{"address": u.hostname, "port": u.port,
                                      "password": up.unquote(u.username or "")}]},
            "streamSettings": stream_from_query(q, u.hostname)}


def parse_ss(link):
    body = link[5:].split("#", 1)[0]
    if "@" not in body:
        body = b64decode_loose(body.split("?", 1)[0]) or ""
    userinfo, _, hostport = body.rpartition("@")
    if ":" not in userinfo:
        userinfo = b64decode_loose(up.unquote(userinfo)) or ""
    method, _, password = userinfo.partition(":")
    hostport = hostport.split("?", 1)[0].rstrip("/")
    host, _, port = hostport.rpartition(":")
    return {"protocol": "shadowsocks",
            "settings": {"servers": [{"address": host.strip("[]"), "port": int(port),
                                      "method": method, "password": password}]}}


def parse_vmess(link):
    data = json.loads(b64decode_loose(link[8:]) or "{}")
    q = {"type": data.get("net") or "tcp", "security": "tls" if data.get("tls") == "tls" else "none",
         "sni": data.get("sni") or data.get("host") or "", "fp": data.get("fp", ""),
         "alpn": data.get("alpn", ""), "path": data.get("path", ""), "host": data.get("host", ""),
         "headerType": data.get("type", ""), "serviceName": data.get("path", "")}
    return data.get("ps", ""), {
        "protocol": "vmess",
        "settings": {"vnext": [{"address": data["add"], "port": int(data["port"]),
                                "users": [{"id": data["id"], "alterId": int(data.get("aid") or 0),
                                           "security": data.get("scy") or "auto"}]}]},
        "streamSettings": stream_from_query(q, data["add"])}


def parse_hysteria2(link):
    u = up.urlsplit(link)
    q = dict(up.parse_qsl(u.query))
    auth = up.unquote(u.username or "")
    if u.password:
        auth += ":" + up.unquote(u.password)
    tls = {"serverName": q.get("sni") or u.hostname, "alpn": ["h3"]}
    if q.get("pinSHA256"):
        tls["pinnedPeerCertSha256"] = q["pinSHA256"].replace(":", "").lower()
    insecure_tls(q, tls)
    if q.get("obfs"):
        raise Unsupported("hy2_obfs")
    return {"protocol": "hysteria",
            "settings": {"version": 2, "address": u.hostname, "port": u.port},
            "streamSettings": {"network": "hysteria", "security": "tls", "tlsSettings": tls,
                               "hysteriaSettings": {"version": 2, "auth": auth}}}


LINK_PARSERS = {"vless": parse_vless, "trojan": parse_trojan, "ss": parse_ss,
                "hysteria2": parse_hysteria2, "hy2": parse_hysteria2}


def parse_links(text, sid):
    nodes, skipped = [], {}
    for line in text.splitlines():
        line = line.strip()
        if "://" not in line:
            continue
        scheme = line.split("://", 1)[0].lower()
        try:
            if scheme == "vmess":
                name, outbound = parse_vmess(line)
            elif scheme in LINK_PARSERS:
                name = up.unquote(up.urlsplit(line).fragment) if "#" in line else ""
                outbound = LINK_PARSERS[scheme](line)
            else:
                add_skip(skipped, "unsupported_scheme", scheme)
                continue
        except Unsupported as why:
            add_skip(skipped, str(why), scheme)
            continue
        except Exception:
            add_skip(skipped, "parse_error", scheme)
            continue
        nid = short_hash(sid + line)
        nodes.append({"id": nid, "name": name or "%s %s" % (scheme, nid), "kind": "node",
                      "outbounds": [dict(outbound, tag="x-" + nid)], "target": "x-" + nid})
    return nodes, skip_items(skipped)


def retag(obj, mapping):
    """Rename the references inside one JSON profile to the new tags."""
    stream = obj.get("streamSettings") or {}
    sockopt = stream.get("sockopt") or {}
    if sockopt.get("dialerProxy") in mapping:
        sockopt["dialerProxy"] = mapping[sockopt["dialerProxy"]]
    proxy_settings = obj.get("proxySettings") or {}
    if proxy_settings.get("tag") in mapping:
        proxy_settings["tag"] = mapping[proxy_settings["tag"]]


def parse_json_profiles(data, sid):
    profiles = data if isinstance(data, list) else [data]
    nodes, skipped = [], {}
    seen = set()
    for index, cfg in enumerate(profiles):
        name = cfg.get("remarks") or "profile %d" % (index + 1)
        outs = cfg.get("outbounds") or []
        if any(o.get("protocol") == "loopback" for o in outs):
            add_skip(skipped, "loopback_profile")
            continue
        proxies = [o for o in outs if o.get("protocol") not in SERVICE_PROTOCOLS]
        if not proxies:
            continue
        if any(((o.get("streamSettings") or {}).get("tlsSettings") or {}).get("allowInsecure")
               for o in proxies):
            add_skip(skipped, "insecure_tls")
            continue
        routing = cfg.get("routing") or {}
        target = None
        for rule in reversed(routing.get("rules") or []):
            conditions = set(rule) - {"type", "network", "outboundTag", "balancerTag", "ruleTag"}
            if not conditions and (rule.get("outboundTag") or rule.get("balancerTag")):
                target = ("balancer", rule["balancerTag"]) if rule.get("balancerTag") \
                    else ("outbound", rule["outboundTag"])
                break
        if target is None:
            target = ("outbound", proxies[0].get("tag"))
        nid = short_hash(sid + json.dumps([proxies, routing.get("balancers")], sort_keys=True))
        if nid in seen:
            continue
        seen.add(nid)
        mapping = {o.get("tag"): "x-%s-%s" % (nid, o.get("tag") or i) for i, o in enumerate(proxies)}
        new_outs = []
        for o in proxies:
            o = json.loads(json.dumps(o))
            o["tag"] = mapping[o.get("tag")]
            retag(o, mapping)
            new_outs.append(o)
        balancers = []
        for b in routing.get("balancers") or []:
            b = json.loads(json.dumps(b))
            b["tag"] = "g-%s-%s" % (nid, b["tag"])
            # selector in xray is a list of tag prefixes: carry the prefix into the profile.
            b["selector"] = ["x-%s-%s" % (nid, s) for s in b.get("selector") or []]
            if b.get("fallbackTag") in mapping:
                b["fallbackTag"] = mapping[b["fallbackTag"]]
            balancers.append(b)
        if target[0] == "balancer":
            kind, tgt = "group", "g-%s-%s" % (nid, target[1])
            if not any(b["tag"] == tgt for b in balancers):
                add_skip(skipped, "no_group")
                continue
        else:
            if target[1] not in mapping:
                add_skip(skipped, "no_node")
                continue
            kind, tgt = "node", mapping[target[1]]
        nodes.append({"id": nid, "name": name, "kind": kind, "outbounds": new_outs,
                      "balancers": balancers, "target": tgt})
    return nodes, skip_items(skipped)


def parse_subscription(body, sid):
    text = body.decode("utf8", "replace").strip().lstrip("﻿")
    if text[:1] in "[{":
        try:
            return parse_json_profiles(json.loads(text), sid)
        except ValueError:
            pass
    if "://" not in text:
        decoded = b64decode_loose(text)
        if decoded and "://" in decoded:
            text = decoded
    if text.startswith(("proxies:", "mixed-port:", "port:")) or "\nproxies:" in text:
        return [], [{"code": "clash_format", "scheme": "", "count": 1}]
    return parse_links(text, sid)


def load_nodes(sid):
    path = os.path.join(SUBS_CACHE, sid + ".raw")
    if not os.path.exists(path):
        return []
    with open(path, "rb") as fh:
        nodes, _ = parse_subscription(fh.read(), sid)
    return nodes


def active_nodes():
    subs = load_subs()
    selection = read_json(SELECTION_FILE, {})
    sid = active_sub_id(selection, subs)
    return subs, selection, sid, (load_nodes(sid) if sid else [])


# ---------------------------------------------------------------- selection

def active_sub_id(selection, subs):
    ids = [sub_id(s) for s in subs]
    if selection.get("sub") in ids:
        return selection["sub"]
    return ids[0] if ids else None


def fallback_problem(selection, nodes):
    """Why the fallback node cannot work: a code, or None if it can."""
    fb = selection.get("fallback") or {}
    by_id = {n["id"]: n for n in nodes}
    if selection.get("mode") != "node" or selection.get("node") not in by_id:
        return "not_node_mode"
    if by_id[selection["node"]]["kind"] != "node":
        return "primary_not_node"
    if not fb.get("node"):
        return "no_fallback_node"
    if fb["node"] not in by_id or by_id[fb["node"]]["kind"] != "node":
        return "fallback_not_found"
    if fb["node"] == selection["node"]:
        return "same_node"
    return None


def fallback_pair(selection, nodes):
    """(primary, fallback) if the fallback is on and applicable; otherwise None.
    A stale setting (the node left the subscription) quietly does nothing."""
    if not (selection.get("fallback") or {}).get("enabled"):
        return None
    if fallback_problem(selection, nodes):
        return None
    by_id = {n["id"]: n for n in nodes}
    return by_id[selection["node"]], by_id[selection["fallback"]["node"]]


def target_for(selection, nodes):
    """Where tunnel traffic goes: the "auto" group, the selected node/profile
    or the pinned balancer (the selected node with its fallback)."""
    if selection.get("mode") == "node":
        for n in nodes:
            if n["id"] == selection.get("node"):
                if fallback_pair(selection, nodes):
                    return {"balancerTag": "pinned"}, n
                key = "balancerTag" if n["kind"] == "group" else "outboundTag"
                return {key: n["target"]}, n
    return {"balancerTag": "auto"}, None


# ---------------------------------------------------------------- per-site rules

DOMAIN_RE = re.compile(r"(?=.{1,253}$)(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\.)+"
                       r"(?:[a-z]{2,63}|xn--[a-z0-9-]{1,59})")


def normalize_host(text):
    """A domain (lower case, no scheme or path) or an IPv4 address; otherwise None."""
    host = (text or "").strip().lower()
    try:
        return str(ipaddress.IPv4Address(host)), "ip"
    except ValueError:
        pass
    if DOMAIN_RE.fullmatch(host) and not re.fullmatch(r"[\d.]+", host):
        return host, "domain"
    return None, None


def load_rules():
    """rules.json without junk: only valid hosts, each host in one list only."""
    raw = read_json(RULES_FILE, {})
    out, seen = {"direct": [], "tunnel": []}, set()
    if not isinstance(raw, dict):
        return out
    for side in ("direct", "tunnel"):
        for item in raw.get(side) or []:
            host, _ = normalize_host(item if isinstance(item, str) else "")
            if host and host not in seen:
                seen.add(host)
                out[side].append(host)
    return out


def user_rules(target, rules):
    """The user's rules. A longer domain comes first: tunnel for mail.x.com
    overrides direct for x.com."""
    items = []
    for side in ("direct", "tunnel"):
        for host in rules[side]:
            _, kind = normalize_host(host)
            items.append((host.count(".") if kind == "domain" else 99, side, kind, host))
    items.sort(key=lambda i: -i[0])
    out = []
    for _, side, kind, host in items:
        key = "domain" if kind == "domain" else "ip"
        value = "domain:" + host if kind == "domain" else host
        dest = {"outboundTag": "direct"} if side == "direct" else dict(target)
        if out and key in out[-1] and out[-1]["_side"] == side and len(out[-1]) == 3:
            out[-1][key].append(value)
            continue
        out.append(dict({key: [value], "_side": side}, **dest))
    for r in out:
        del r["_side"]
    return out


def rule_for(host, ip, rules):
    """Which of the user's rules would match a connection: by host/suffix or by address."""
    best = None
    for side in ("direct", "tunnel"):
        for h in rules[side]:
            if h == ip or h == host or (host and host.endswith("." + h)):
                depth = h.count(".") if not re.fullmatch(r"[\d.]+", h) else 99
                if best is None or depth > best[0]:
                    best = (depth, side)
    return best[1] if best else None


# ---------------------------------------------------------------- building the config

def harden(outbound, iface=None):
    """Sockets to the node: marked and through the physical interface, past our own TUN."""
    stream = outbound.setdefault("streamSettings", {})
    sockopt = stream.setdefault("sockopt", {})
    chained = sockopt.get("dialerProxy") or (outbound.get("proxySettings") or {}).get("tag")
    if not chained:
        sockopt["mark"] = MARK
        if iface:
            sockopt["interface"] = iface
        # The node's name is resolved by the built-in DNS, which asks the router for node names:
        # otherwise the system resolver would ask xray itself, and the tunnel would wait for itself.
        sockopt.setdefault("domainStrategy", "UseIPv4")
    return outbound


def node_hosts(nodes):
    hosts = set()
    for n in nodes:
        for o in n["outbounds"]:
            s = o.get("settings") or {}
            for server in (s.get("vnext") or []) + (s.get("servers") or []) + [s]:
                addr = server.get("address") if isinstance(server, dict) else None
                if addr and not re.fullmatch(r"[\d.]+|[0-9a-fA-F:]+", addr):
                    hosts.add(addr)
    return sorted(hosts)


def routing_rules(target, rules=None, net=None, st=None):
    net = network() if net is None else net
    st = st or load_settings()
    lan_dns = (net or {}).get("lan_dns") or []
    head = [
        # Queries that are not about addresses (TXT, SRV, MX) are not served by the built-in DNS:
        # dns-out passes them as they are to 1.1.1.1, and the dns-relay loop brings them
        # back into routing, so they go into the tunnel, not out in clear text.
        dict({"inboundTag": ["dns-relay-in"]}, **target),
        {"inboundTag": ["dns-in"], "outboundTag": "dns-out"},
        # DNS hijack: an application asked another resolver, bypassing the system one;
        # the core answers anyway, and no query leaves in clear text.
        {"inboundTag": ["tun"], "port": "53", "outboundTag": "dns-out"},
        {"inboundTag": ["dns-internal"], "ip": lan_dns, "outboundTag": "direct"},
        dict({"inboundTag": ["dns-internal"]}, **target),
    ]
    if not lan_dns:
        del head[3]
    direct_ip = ["geoip:" + c for c in st["direct_geo"]["geoip"]]
    tail_rules = [
        {"ip": ["geoip:private"] + st["local_nets"], "outboundTag": "direct"},
        {"domain": direct_domains(st), "outboundTag": "direct"},
        {"ip": direct_ip, "outboundTag": "direct"},
        dict({"network": "tcp,udp"}, **target),
    ]
    tail_rules = [r for r in tail_rules if r.get("domain", True) and r.get("ip", True)]
    rules = head + user_rules(target, rules or {"direct": [], "tunnel": []}) + tail_rules
    for i, rule in enumerate(rules):
        rule["type"] = "field"
        rule["ruleTag"] = "r%d" % i
    return rules


def all_balancers(nodes, selection=None):
    """The "auto" group over all nodes of the subscription, plus groups from JSON profiles
    and, with the fallback node on, pinned: the primary, and the fallback when the primary dies."""
    out = [{"tag": "auto", "selector": ["x-"], "strategy": {"type": "leastPing"},
            "fallbackTag": nodes[0]["outbounds"][0]["tag"]}]
    for n in nodes:
        out += n.get("balancers") or []
    pair = fallback_pair(selection or {}, nodes)
    if pair:
        # leastPing picks only among the living, by observatory data;
        # with none alive the core takes fallbackTag. The primary comes back: it is used again.
        out.append({"tag": "pinned", "selector": [pair[0]["target"]], "strategy": {"type": "leastPing"},
                    "fallbackTag": pair[1]["target"]})
    return out


def observatory_for(selection, nodes, proxy_tags):
    pair = fallback_pair(selection, nodes)
    # Node probing: less often on a big subscription, or the background becomes hundreds of requests.
    interval = "2m" if len(proxy_tags) <= 40 else "10m"
    selector = ["x-"]
    if pair:
        interval = FALLBACK_PROBE
        if len(proxy_tags) > 40:
            selector = [pair[0]["target"], pair[1]["target"]]
    return {"subjectSelector": selector, "probeURL": PROBE_URL,
            "probeInterval": interval, "enableConcurrency": True}


def build_config(selection, nodes, rules=None, net=None):
    net = (network() or {}) if net is None else net
    st = load_settings()
    iface = net.get("iface")
    target, _ = target_for(selection, nodes)
    outbounds = []
    for n in nodes:
        outbounds += [harden(json.loads(json.dumps(o)), iface) for o in n["outbounds"]]
    proxy_tags = [o["tag"] for o in outbounds]
    balancers = all_balancers(nodes, selection)
    return {
        "log": {"loglevel": "warning", "access": ACCESS_LOG, "error": ERROR_LOG, "dnsLog": True},
        "api": {"tag": "api", "listen": API,
                "services": ["RoutingService", "StatsService", "HandlerService", "ObservatoryService"]},
        "metrics": {"tag": "metrics", "listen": METRICS.split("//")[1].split("/")[0]},
        "stats": {},
        "policy": {"system": {"statsOutboundUplink": True, "statsOutboundDownlink": True}},
        "observatory": observatory_for(selection, nodes, proxy_tags),
        "dns": {
            "servers": [
                {"address": a, "domains": lan_dns_domains(st, net) + ["full:" + h for h in node_hosts(nodes)],
                 "skipFallback": True} for a in (net.get("lan_dns") or [])[:2]
            ] + [
                "https://1.1.1.1/dns-query",
                "https://8.8.8.8/dns-query",
            ],
            "queryStrategy": "UseIPv4",
            "tag": "dns-internal",
        },
        "inbounds": [
            {"tag": "tun", "protocol": "tun",
             "settings": {"name": DEV, "MTU": 1500, "gateway": [GATEWAY]},
             "sniffing": {"enabled": True, "destOverride": ["http", "tls", "quic"], "routeOnly": True}},
            {"tag": "dns-in", "listen": "127.0.0.1", "port": 53, "protocol": "dokodemo-door",
             "settings": {"address": "1.1.1.1", "port": 53, "network": "tcp,udp"}},
        ],
        "outbounds": outbounds + [
            {"tag": "direct", "protocol": "freedom",
             "streamSettings": {"sockopt": dict({"mark": MARK, "domainStrategy": "UseIPv4"},
                                                **({"interface": iface} if iface else {}))}},
            {"tag": "block", "protocol": "blackhole"},
            {"tag": "dns-out", "protocol": "dns",
             "settings": {"nonIPQuery": "skip", "address": "1.1.1.1", "port": 53, "network": "tcp"},
             "streamSettings": {"sockopt": {"dialerProxy": "dns-relay"}}},
            {"tag": "dns-relay", "protocol": "loopback", "settings": {"inboundTag": "dns-relay-in"}},
        ],
        "routing": {"domainStrategy": "AsIs", "balancers": balancers,
                    "rules": routing_rules(target, load_rules() if rules is None else rules, net, st)},
    }


def ensure_geo():
    """geoip.dat and geosite.dat in ASSET_DIR are links to the distribution's
    copies. Anything else there (a file the 0.5 `geo` command downloaded from a
    third party without a check, a dangling link) is replaced by the link."""
    os.makedirs(ASSET_DIR, exist_ok=True)
    for name in GEO_FILES:
        path = os.path.join(ASSET_DIR, name)
        system = os.path.join(SYSTEM_GEO_DIR, name)
        if not os.path.exists(system):
            continue
        if os.path.islink(path) and os.readlink(path) == system:
            continue
        if os.path.lexists(path):
            os.unlink(path)
        os.symlink(system, path)


def xray_test(path, binary=None):
    ensure_geo()
    env = dict(os.environ, XRAY_LOCATION_ASSET=ASSET_DIR)
    try:
        os.makedirs(RUN_DIR, mode=0o700, exist_ok=True)
    except OSError as error:
        # No user session (no /run/user/UID): the config's logs have nowhere to go.
        return False, "no runtime directory %s (%s); run this in your desktop session" % (RUN_DIR, error.strerror)
    r = subprocess.run([binary or XRAY, "run", "-test", "-c", path], capture_output=True, text=True,
                       env=env, timeout=60)
    ok = "Configuration OK" in r.stdout
    if ok:
        return True, ""
    lines = (r.stdout + r.stderr).strip().splitlines()
    failed = [l for l in lines if "Failed" in l or "failed" in l]
    # The last link of the chain "> ... > ..." is the reason itself; it holds no node secrets.
    return False, (failed or lines or [""])[-1].split(" > ")[-1]


def cmd_build(args):
    """Build the config. An error does not break the start: the previous working config stays."""
    try:
        subs, selection, sid, nodes = active_nodes()
        if not nodes:
            raise RuntimeError("the active subscription has no nodes (xray-omarchy update)")
        net = network(refresh=True)
        if not net:
            raise RuntimeError("cannot detect the network: " + network_error())
        cfg = build_config(selection, nodes, net=net)
        os.makedirs(RUN_DIR, mode=0o700, exist_ok=True)
        candidate = CONFIG_FILE[:-5] + ".new.json"
        write_private(candidate, json.dumps(cfg, ensure_ascii=False, indent=1))
        ok, err = xray_test(candidate)
        if not ok:
            os.unlink(candidate)
            raise RuntimeError("xray rejected config: " + err)
        os.replace(candidate, CONFIG_FILE)
        say("config built: %d nodes" % len(nodes))
    except Exception as error:
        say("config not rebuilt (%s)%s" % (
            error, ", keeping the previous one" if os.path.exists(CONFIG_FILE) else ""))
        return 0 if os.path.exists(CONFIG_FILE) else 1
    return 0


# ---------------------------------------------------------------- routes, killswitch, DNS

def dev_is_up():
    """The TUN exists and is administratively up (IFF_UP); a TUN's operstate stays "unknown"."""
    try:
        with open("/sys/class/net/%s/flags" % DEV) as fh:
            return int(fh.read().strip(), 16) & 0x1 == 0x1
    except (OSError, ValueError):
        return False


def net_record(code, detail=""):
    try:
        write_json(NET_FILE, {"code": code, "detail": detail[:200], "time": int(time.time())})
    except OSError:
        pass


def net_failure():
    """The code of the last failed `net up` if it is recent ("" otherwise):
    while it fails the unit is restarting, never `active`, and status says why."""
    rec = read_json(NET_FILE, {})
    if not isinstance(rec, dict) or not rec.get("code"):
        return ""
    if time.time() - (rec.get("time") or 0) > NET_FAIL_FRESH:
        return ""
    return str(rec["code"])


def cmd_net(args):
    if args.action == "up":
        # The core creates the device and brings it up a moment later; a route
        # to a device that is not up yet is refused ("Device for nexthop is not
        # up"), which at boot left the tunnel running without routes.
        for _ in range(100):
            if dev_is_up():
                break
            time.sleep(0.1)
        else:
            say("net: device %s did not come up" % DEV)
            net_record("no_tun", "device %s did not come up" % DEV)
            return 1
        # ip rule 9100 (main without a default route) and 9110 (everything else into the TUN,
        # except the core's marked sockets) are set by the helper. A refusal is
        # tried again a few times (the device may go down and up once more
        # while the core starts), except 4: a TUN not held by this user's core.
        for attempt in range(5):
            if attempt:
                time.sleep(1)
            r = helper("route", "up")
            if r.returncode in (0, 4):
                break
        if r.returncode != 0:
            why = (r.stderr.strip() or r.stdout.strip())[:200]
            say("net: routes not set (%s)" % why)
            # Non-zero: ExecStartPost fails, the unit stops (net down) and
            # systemd starts it again (Restart=always): it never stays
            # `active` without routes, and it heals by itself once routes can
            # be set. `on` reads the code: 4 is a TUN not held by this user's core.
            net_record("foreign_tun" if r.returncode == 4 else "not_routed", why)
            return 1
        net_record("")
        # Which node probing the core started with: probing changes only with a restart,
        # and fallback/select decide from this snapshot whether one is needed.
        cfg = read_json(CONFIG_FILE, {})
        if cfg.get("observatory"):
            try:
                write_json(STARTED_FILE, {"observatory": cfg["observatory"], "time": int(time.time())})
            except OSError:
                pass
        say("net: routes into %s are set" % DEV)
        return 0
    helper("route", "down")
    say("net: routes removed")
    return 0


def killswitch_args(net):
    """(helper arguments, warnings). The network's DNS and DHCP servers are let
    past the killswitch only inside the local networks: a public DNS from the
    router (8.8.8.8, say) would be DNS past the tunnel, so it is left out."""
    st = load_settings()
    nets = st["local_nets"]
    warnings = list(st["warnings"])
    args = ["killswitch", "on"]
    for addr in (net or {}).get("lan_dns") or []:
        addr = _clean_ip(addr)
        if not addr:
            continue
        if in_nets(addr, nets):
            args += ["--lan-dns", addr]
        else:
            warnings.append("the network's DNS %s is public: programs cannot reach it past the killswitch, "
                            "but the core asks it for node names and local zones in plain DNS" % addr)
    for cidr in nets:
        args += ["--local-net", cidr]
    server = _clean_ip((net or {}).get("dhcp_server") or "")
    if server and ipaddress.ip_address(server).version == 4:
        if in_nets(server, nets):
            args += ["--dhcp-server", server]
        else:
            warnings.append("the DHCP server %s is not in a local network: renewals go by broadcast only"
                            % server)
    return args, warnings


def killswitch_on():
    """Without a live tunnel nobody goes out through the physical interfaces
    except the core's sockets and Tailscale, local networks, DHCP, the network's DNS and time sync.
    nftables table inet xray-omarchy; the helper remembers it and restores it at boot."""
    args, warnings = killswitch_args(network(refresh=True))
    for w in warnings:
        log("killswitch: " + w)
    r = helper(*args)
    if r.returncode != 0:
        raise RuntimeError((r.stderr.strip() or r.stdout.strip() or "helper failed")[:200])


def killswitch_off():
    r = helper("killswitch", "off")
    if r.returncode != 0:
        log("killswitch off: %s" % (r.stderr.strip() or r.stdout.strip())[:200])


def killswitch_state():
    """on | off | tampered (the table in the kernel is not the one loaded) | unknown."""
    out = helper("killswitch", "status").stdout.strip()
    return out if out in ("on", "off", "tampered") else "unknown"


def cmd_fw(args):
    """Non-zero unless the killswitch is in the asked state: the unit's
    ExecStartPre=fw on must keep the core from starting without it."""
    try:
        if args.action == "on":
            killswitch_on()
        else:
            killswitch_off()
    except Exception as error:
        say("killswitch: not applied (%s)" % error)
        return 1
    state = killswitch_state()
    say("killswitch: %s" % state)
    return 0 if state == args.action else 1


def dns_set(on):
    """System DNS to the core (127.0.0.1) or back to the network. Through the helper: from
    a background service polkit would ask for a password nobody is there to type.
    Returns "" or an error code."""
    net = network(refresh=True)
    if on:
        if not net:
            return "network_unknown"
        # The helper saves the connection's own DNS settings first and puts
        # exactly them back on `dns off`.
        r = helper("dns", "on", net["uuid"], net["iface"])
        if r.returncode != 0:
            log("dns on: %s" % (r.stderr.strip() or r.stdout.strip())[:200])
            # 4: 127.0.0.1:53 is not this user's core — DNS is not handed to it.
            return "foreign_dns" if r.returncode == 4 else "dns_failed"
        return ""
    # Back only what the helper switched and saved: its list, not a guess.
    r = helper("dns", "list")
    try:
        targets = json.loads(r.stdout.strip().splitlines()[-1]) if r.returncode == 0 else None
    except (ValueError, IndexError):
        targets = None
    if not isinstance(targets, list):
        log("dns list: %s" % (r.stderr.strip() or r.stdout.strip())[:200])
        return "dns_failed"
    code = ""
    for t in targets:
        if not isinstance(t, dict) or not isinstance(t.get("uuid"), str):
            continue
        iface = t.get("iface") or (net or {}).get("iface") or "lo"
        r = helper("dns", "off", t["uuid"], iface)
        if r.returncode != 0:
            log("dns off: %s" % (r.stderr.strip() or r.stdout.strip())[:200])
            code = "dns_failed"
    return code


RESOLVECTL_LINE = re.compile(r"(?:Global|Link \d+ \(([^)]*)\)):(.*)")


def dns_servers():
    """Every DNS server systemd-resolved may ask, per link: [(link, server)].
    None when resolvectl does not answer."""
    try:
        r = run(["resolvectl", "dns"], timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        return None
    if r.returncode != 0:
        return None
    out = []
    for line in r.stdout.splitlines():
        m = RESOLVECTL_LINE.fullmatch(line.strip())
        if m:
            out += [(m.group(1) or "", server) for server in m.group(2).split()]
    return out


def dns_state():
    """xray: the core is the only DNS the system asks; router: the core is not
    asked at all; mixed: both (another link or an IPv6 server from the router
    answers past the core); unknown: resolvectl did not answer.
    Tailscale's link is not counted: MagicDNS answers inside the tailnet."""
    servers = dns_servers()
    if servers is None:
        # No systemd-resolved: the system asks what resolv.conf names.
        try:
            with open("/etc/resolv.conf", encoding="utf8") as fh:
                servers = [("", l.split()[1]) for l in fh if l.startswith("nameserver") and len(l.split()) > 1]
        except OSError:
            return "unknown"
        if not servers:
            return "unknown"
    servers = [(link, s) for link, s in servers if not (link == DEV or link.startswith("tailscale"))]
    core = [s for _, s in servers if s.split("#")[0] in ("127.0.0.1", "127.0.0.1:53")]
    if core and len(core) == len(servers):
        return "xray"
    return "mixed" if core else "router"


def cmd_dns(args):
    code = dns_set(args.action == "on")
    if code == "network_unknown":
        say("system DNS: not switched, cannot detect the network (%s)" % network_error())
        return 1
    if code == "foreign_dns":
        say("system DNS: not switched, 127.0.0.1:53 is not served by your xray core (see %s)" % LOG_FILE)
        return 4
    if code:
        say("system DNS: not switched, the helper refused (see %s)" % LOG_FILE)
        return 1
    time.sleep(1)
    say("system DNS: %s" % dns_state())
    return 0


# ---------------------------------------------------------------- service

def service_active(unit=None):
    return run(["systemctl", "--user", "is-active", "--quiet", unit or UNIT]).returncode == 0


def restart_core():
    cmd_build(None)
    run(["systemctl", "--user", "restart", UNIT], timeout=60)


def journal_lines(limit=40):
    """Journal lines of the service's current run only: earlier failures do not count."""
    inv = run(["systemctl", "--user", "show", "-p", "InvocationID", "--value", UNIT]).stdout.strip()
    if inv:
        # Lines from the service's processes carry _SYSTEMD_INVOCATION_ID, systemd's own
        # lines about it carry USER_INVOCATION_ID.
        cmd = ["journalctl", "--user", "_SYSTEMD_INVOCATION_ID=" + inv, "+", "USER_INVOCATION_ID=" + inv]
    else:
        cmd = ["journalctl", "--user", "-u", UNIT]
    return run(cmd + ["-n", str(limit), "-o", "cat", "--no-pager"]).stdout.splitlines()


REJECT_MARKERS = ("xray rejected config: ",)
# This program's own lines in the unit's journal (ExecStartPre/Post): never
# taken for the core's reason.
OWN_PREFIXES = ("config ", "killswitch:", "net:", "system DNS:", "network changed")


def core_failure_detail():
    """The last meaningful journal line of the current run: why the core did not come up."""
    for line in reversed(journal_lines()):
        # From our own messages take only what they quote from xray.
        for marker in REJECT_MARKERS:
            if marker in line:
                return ("config rejected: " + line.split(marker, 1)[1].rstrip(")"))[:200]
        if line.startswith(OWN_PREFIXES) or any(n in line for n in ERROR_NOISE):
            continue
        low = line.lower()
        if "failed to start" in low or "error" in low:
            return line.split(" > ")[-1].strip()[:200]
    return ""


def net_reason():
    """(code, detail) when this start's `net up` failed, else None. The unit
    keeps retrying by itself (Restart=always); the killswitch holds meanwhile."""
    rec = read_json(NET_FILE, {})
    code = rec.get("code") if isinstance(rec, dict) else None
    if code == "foreign_tun":
        return code, "%s is held by something other than your xray core" % DEV
    if code in ("not_routed", "no_tun"):
        return code, str(rec.get("detail") or "")
    return None


def cmd_on(args):
    net = network(refresh=True)
    if not net:
        why = network_error()
        return finish(args, False, "network_unknown", why, "cannot detect the network: %s" % why)
    try:
        os.unlink(NET_FILE)
    except OSError:
        pass
    # enable: the tunnel comes back after a reboot until `off`.
    r = run(["systemctl", "--user", "enable", "--now", UNIT], timeout=60)
    if r.returncode != 0:
        net = net_reason()
        if net:
            return finish(args, False, net[0], net[1], "tunnel did not come up (%s) %s" % net)
        detail = core_failure_detail()
        return finish(args, False, "start_failed", detail, "core did not start: %s" % (detail or r.stderr.strip()))
    # Type=simple: start returns at once, and the core may die a second later.
    for _ in range(40):
        if service_active() and os.path.exists("/sys/class/net/" + DEV) \
                and "%d:" % PREF_TUN in run(["ip", "rule"]).stdout:
            break
        time.sleep(0.25)
    else:
        detail = core_failure_detail()
        code = "core_crashed" if not service_active() else "no_tun"
        net = net_reason()
        if net:
            code, detail = net
        return finish(args, False, code, detail, "tunnel did not come up (%s) %s" % (code, detail))
    code = dns_set(True)
    time.sleep(1)
    if code == "network_unknown":
        why = network_error()
        return finish(args, False, "network_unknown", why, "tunnel is up, but the network is unknown: %s" % why)
    if code == "foreign_dns":
        return finish(args, False, "foreign_dns", "",
                      "tunnel is up, but 127.0.0.1:53 is held by something other than your xray core: "
                      "system DNS not switched")
    if dns_state() != "xray":
        return finish(args, False, "dns_failed", "", "tunnel is up, but system DNS did not switch to the core")
    return finish(args, True, "", "", "tunnel is up")


def cmd_off(args):
    # Order: the killswitch first, or without the tunnel there is no way out at all.
    killswitch_off()
    if killswitch_state() != "off":
        return finish(args, False, "killswitch_failed", "", "killswitch did not lift, keeping the tunnel")
    dns_set(False)
    run(["systemctl", "--user", "disable", "--now", UNIT], timeout=60)
    time.sleep(1)
    if service_active():
        return finish(args, False, "stop_failed", "", "core did not stop")
    if dns_state() != "router":
        return finish(args, False, "dns_failed", "",
                      "tunnel is down, but system DNS did not return to the network's own settings")
    net = network(refresh=True) or {}
    servers = ", ".join(net.get("lan_dns") or []) or "none known"
    return finish(args, True, "", "", "tunnel is down, direct exit, the network's DNS (%s: %s)"
                  % (DNS_SOURCE_TEXT.get(net.get("source"), net.get("source") or "unknown"), servers))


def running_observatory(selection, nodes):
    """The node probing the core started with. No snapshot (the core was started
    by an earlier version) means the earlier probing, without the fallback node."""
    snap = read_json(STARTED_FILE, {})
    if snap.get("observatory"):
        return snap["observatory"]
    tags = [o["tag"] for n in nodes for o in n["outbounds"]]
    return observatory_for(dict(selection, fallback={"enabled": False}), nodes, tags)


def restart_needed(selection, nodes):
    if not nodes or not service_active():
        return False
    return build_config(selection, nodes)["observatory"] != running_observatory(selection, nodes)


def live_selection(selection, nodes):
    """What can be applied to the running core. pinned without probing the primary
    would move all traffic to the fallback, so until a restart it is left out."""
    pair = fallback_pair(selection, nodes)
    if not pair:
        return selection
    probed = running_observatory(selection, nodes).get("subjectSelector") or []
    if any(pair[0]["target"].startswith(s) for s in probed):
        return selection
    return dict(selection, fallback=dict(selection["fallback"], enabled=False))


def push_rules(selection, nodes):
    """Rules and balancers into the running core as a whole, without a restart."""
    selection = live_selection(selection, nodes)
    target, _ = target_for(selection, nodes)
    balancers = all_balancers(nodes, selection)
    os.makedirs(RUN_DIR, mode=0o700, exist_ok=True)
    path = os.path.join(RUN_DIR, "rules.json")
    write_private(path, json.dumps({"routing": {"balancers": balancers,
                                                "rules": routing_rules(target, load_rules())}}))
    # adrules builds the rules on the client side, so it needs geoip/geosite too.
    r = subprocess.run([XRAY, "api", "adrules", "--server=" + API, path], capture_output=True,
                       text=True, timeout=15, env=dict(os.environ, XRAY_LOCATION_ASSET=ASSET_DIR))
    os.unlink(path)
    return r.returncode == 0 and "failed" not in (r.stdout + r.stderr)


def cmd_select(args):
    subs, selection, sid, nodes = active_nodes()
    if args.node == "auto":
        selection.update({"sub": sid, "mode": "auto", "node": None})
        label = "auto"
    else:
        match = [n for n in nodes if n["id"] == args.node]
        if not match:
            return finish(args, False, "not_found", args.node,
                          "node %s is not in the active subscription" % args.node)
        selection.update({"sub": sid, "mode": "node", "node": args.node})
        label = match[0]["name"]
    write_json(SELECTION_FILE, selection)
    cmd_build(None)
    if not service_active():
        return finish(args, True, "", "", "selected: %s" % label)
    if push_rules(selection, nodes):
        code, text = "", "selected: %s (no restart)" % label
    else:
        code, text = "restarted", "selected: %s; live rules were not accepted, restarting the core" % label
        run(["systemctl", "--user", "restart", UNIT], timeout=60)
    if not code and restart_needed(selection, nodes) and live_selection(selection, nodes) is not selection:
        # Big subscription with a fallback: the core does not probe the new primary.
        code, text = "restart_needed", text + "; the fallback node starts working after a core restart"
    # The exit address is cached for 10 minutes; after a node change it is stale.
    exit_info(refresh=True)
    return finish(args, True, code, "", text)


def cmd_use(args):
    subs = load_subs()
    match = [s for s in subs if s["name"] == args.name]
    if not match:
        return finish(args, False, "not_found", args.name, "no subscription %s" % args.name)
    sid = sub_id(match[0])
    if not load_nodes(sid):
        return finish(args, False, "no_nodes", args.name,
                      "subscription %s has no nodes, run xray-omarchy update first" % args.name)
    write_json(SELECTION_FILE, {"sub": sid, "mode": "auto", "node": None})
    if service_active():
        restart_core()
    else:
        cmd_build(None)
    return finish(args, True, "", "", "active subscription: %s, auto mode" % args.name)


