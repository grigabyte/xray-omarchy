def account_traffic(m):
    """Accumulates traffic per day: the core's counters reset on every restart."""
    os.makedirs(STATE_DIR, mode=0o700, exist_ok=True)
    lock = open(TRAFFIC_FILE + ".lock", "w")
    fcntl.flock(lock, fcntl.LOCK_EX)
    try:
        t = read_json(TRAFFIC_FILE, {})
        now = time.time()
        today = time.strftime("%F")
        days = t.setdefault("days", {})
        day = days.setdefault(today, {"tunnel_up": 0, "tunnel_down": 0, "direct_up": 0, "direct_down": 0})
        cur = {"tunnel_up": 0, "tunnel_down": 0, "direct_up": 0, "direct_down": 0}
        for tag, v in ((m or {}).get("stats") or {}).get("outbound", {}).items():
            side = "direct" if tag == "direct" else "tunnel" if tag.startswith("x-") else None
            if side:
                cur[side + "_up"] += v.get("uplink", 0)
                cur[side + "_down"] += v.get("downlink", 0)
        last = t.get("last") or {}
        rate = {}
        dt = now - last.get("ts", now)
        for key, value in cur.items():
            prev = last.get(key, 0)
            delta = value - prev if value >= prev else value  # the core restarted
            day[key] = day.get(key, 0) + delta
            rate[key] = int(delta / dt) if dt > 0.5 else 0
        t["last"] = dict(cur, ts=now)
        if dt > 0.5:
            t["rate"] = rate
        for old in sorted(days)[:-31]:
            del days[old]
        write_json(TRAFFIC_FILE, t)
        return day, t.get("rate", {})
    finally:
        lock.close()


def tail(path, limit, max_bytes=400_000):
    try:
        with open(path, "rb") as fh:
            fh.seek(0, 2)
            size = fh.tell()
            fh.seek(max(0, size - max_bytes))
            lines = fh.read().decode("utf8", "replace").splitlines()
    except OSError:
        return []
    return lines[-limit:]


ACCESS_RE = re.compile(r"^(\S+ \S+) from (\S+) accepted (\w+):(.+):(\d+) \[(.+?)\]")
DNS_RE = re.compile(r"(?:got answer|cache HIT): (\S+?)\.? (?:Type\w+ )?-> \[([^\]]*)\]")
# In and out in the core's log: "tun -> x-...", through a balancer "tun >> x-...".
DETOUR_RE = re.compile(r"\s*(?:==>|->|>>)\s*")


def ip_names():
    """Address to name from the core's DNS answers, accumulated.

    The system resolver caches answers and does not ask the core every time, so
    one tail of the log is not enough. The table lives in tmpfs next to the log and goes
    away with it; only what was appended since the last read is read.
    """
    path = os.path.join(RUN_DIR, "names.json")
    state = read_json(path, {})
    names, offset = state.get("names", {}), state.get("offset", 0)
    try:
        with open(ACCESS_LOG, "rb") as fh:
            fh.seek(0, 2)
            size = fh.tell()
            if size < offset:  # the log was truncated
                offset = max(0, size - 400_000)
            fh.seek(offset)
            chunk = fh.read(4_000_000)
            offset += len(chunk)
    except OSError:
        return names
    for line in chunk.decode("utf8", "replace").splitlines():
        d = DNS_RE.search(line)
        if d:
            # An answer with several addresses: "[a, b]"; the comma is not part of an address.
            for ip in re.split(r"[,\s]+", d.group(2).strip()):
                names[ip] = d.group(1)
    if len(names) > 5000:
        names = dict(list(names.items())[-4000:])
    try:
        write_json(path, {"names": names, "offset": offset})
    except OSError:
        pass
    return names


def recent_connections(names, limit=60, rules=None):
    """Where connections went: address to name by the core's DNS answers, route to node."""
    rules = rules or load_rules()
    lines = tail(ACCESS_LOG, 4000)
    ip_name = ip_names()
    probes = load_probes()
    out = []
    for line in lines:
        a = ACCESS_RE.match(line)
        if not a:
            continue
        ts, src, proto, host, port, route = a.groups()
        if not route.startswith("tun"):
            continue
        # The site checks' own requests are not the user's connections.
        if is_probe(probes, ts, src, host.strip("[]"), port):
            continue
        outbound = DETOUR_RE.split(route.strip())[-1]
        if outbound == "dns-out":
            continue
        host = host.strip("[]")
        if host.startswith(("ff0", "224.", "239.", "255.")):
            continue  # mDNS, SSDP and other broadcast: noise
        name = ip_name.get(host, host)
        out.append({"time": ts.split()[1][:8], "host": name, "ip": host,
                    "port": int(port), "proto": proto,
                    "via": "direct" if outbound == "direct" else "block" if outbound == "block" else "tunnel",
                    "node": names.get(outbound, outbound),
                    "rule": rule_for(name, host, rules)})
    # One host, one row with a connection count: the picture is useful, not every socket.
    folded, index = [], {}
    for item in reversed(out):
        key = (item["host"], item["via"])
        if key in index:
            index[key]["count"] += 1
            continue
        item["count"] = 1
        index[key] = item
        folded.append(item)
    return folded[:limit]


# Warnings that are not errors: the core starting and deprecated settings.
ERROR_NOISE = ("core: Xray", "is deprecated", "deprecated, not recommended")


def recent_errors(limit=15):
    # The session number "[3301886461] " in a line is internal and gets in the way.
    return [re.sub(r"\[\d{6,}\] ", "", l) for l in tail(ERROR_LOG, 400)
            if ("[Warning]" in l or "[Error]" in l) and not any(n in l for n in ERROR_NOISE)][-limit:]


PROTECTION_TEXT = {
    "core_stopped": "core is not running",
    "no_tun": "no device " + DEV,
    "not_routed": "traffic is not routed into the tunnel",
    "killswitch_off": "killswitch is off",
    "killswitch_unknown": "killswitch state is unknown",
    "killswitch_tampered": "the killswitch table was changed after it was loaded",
    "dns_bypass": "DNS bypasses the core",
}


def protection(running, tun, killswitch, dns, service=""):
    """One "protected" verdict and the list of what is wrong, for the panel's header."""
    codes = []
    if not running and service == "activating" and net_failure() in ("not_routed", "no_tun", "foreign_tun"):
        # `net up` failed and systemd is starting the unit again: the core
        # runs between attempts, but traffic does not go into the tunnel.
        codes.append("not_routed")
    elif not running:
        codes.append("core_stopped")
    elif not tun:
        codes.append("no_tun")
    elif "%d:" % PREF_TUN not in run(["ip", "rule"]).stdout:
        codes.append("not_routed")
    if killswitch != "on":
        codes.append({"off": "killswitch_off", "tampered": "killswitch_tampered"}.get(killswitch,
                                                                                    "killswitch_unknown"))
    if dns != "xray":
        codes.append("dns_bypass")
    # problems is text for the terminal; the panel translates the codes itself.
    return {"ok": not codes, "codes": codes, "problems": [PROTECTION_TEXT[c] for c in codes]}


def exit_info(refresh=False):
    info = read_json(EXIT_FILE, {})
    if refresh or time.time() - info.get("ts", 0) > 600:
        try:
            with urllib.request.urlopen("https://1.1.1.1/cdn-cgi/trace", timeout=8) as resp:
                kv = dict(l.split("=", 1) for l in read_limited(resp, 16384).decode().splitlines() if "=" in l)
            info = {"ip": kv.get("ip"), "country": kv.get("loc"), "ts": int(time.time())}
        except Exception:
            info = {"ip": None, "country": None, "ts": int(time.time())}
        write_json(EXIT_FILE, info)
    return info


def node_alive(node, obs):
    """True: at least one node exit is alive; False: all probed and dead; None: not probed."""
    tags = [o["tag"] for o in node["outbounds"]]
    probed = [t for t in tags if t in obs]
    if not probed:
        return None
    return any(obs[t].get("alive") for t in probed)


def node_table(nodes, m):
    obs = (m or {}).get("observatory") or {}
    stats = ((m or {}).get("stats") or {}).get("outbound") or {}
    rows = []
    for n in nodes:
        tags = [o["tag"] for o in n["outbounds"]]
        delays = [obs[t]["delay"] for t in tags if t in obs and obs[t].get("alive")]
        probed = any(t in obs for t in tags)
        traffic = sum(stats.get(t, {}).get("uplink", 0) + stats.get(t, {}).get("downlink", 0) for t in tags)
        rows.append({"id": n["id"], "name": n["name"], "kind": n["kind"], "members": len(tags),
                     "delay": min(delays) if delays else None,
                     "alive": bool(delays) if probed else None, "traffic": traffic})
    return rows


def notify_enabled():
    return bool(read_json(SETTINGS_FILE, {}).get("notify", True))


def gather(with_nodes=False, refresh_exit=False):
    subs, selection, sid, nodes = active_nodes()
    running = service_active()
    m = metrics() if running else None
    names = {}
    tag_ids = {}
    for n in nodes:
        for o in n["outbounds"]:
            names[o["tag"]] = n["name"]
            tag_ids[o["tag"]] = n["id"]
    today, rate = account_traffic(m) if m else (read_json(TRAFFIC_FILE, {}).get("days", {}).get(time.strftime("%F"), {}), {})
    _, chosen = target_for(selection, nodes)
    fallback = fallback_status(selection, nodes, running)
    current = None
    current_id = None
    if running:
        if chosen and fallback["ready"] and fallback["active"] is not None:
            # The node pinned actually uses: primary or fallback.
            pick = fallback["pick"] or (selection["fallback"]["node"] and
                                        {n["id"]: n for n in nodes}[selection["fallback"]["node"]]["target"])
            current = names.get(pick, pick)
            current_id = tag_ids.get(pick)
        elif chosen:
            current = chosen["name"]
            current_id = chosen["id"]
        else:
            _, pick = balancer_pick("auto")
            current = names.get(pick, pick)
            current_id = tag_ids.get(pick)
    del fallback["pick"]
    sub_rows = []
    for s in subs:
        meta = read_json(os.path.join(SUBS_CACHE, sub_id(s) + ".meta.json"), {})
        sub_rows.append({"name": s["name"], "active": sub_id(s) == sid, "count": meta.get("count", 0),
                         "updated": meta.get("updated"), "title": meta.get("title"),
                         "userinfo": meta.get("userinfo") or {}, "skipped": meta.get("skipped") or []})
    rules = load_rules()
    state = {
        "running": running,
        "service": run(["systemctl", "--user", "is-active", UNIT]).stdout.strip(),
        "tun": os.path.exists("/sys/class/net/" + DEV),
        "killswitch": killswitch_state(),
        "dns": dns_state(),
        "mode": "node" if chosen else "auto",
        "selected": chosen["id"] if chosen else None,
        "current": current,
        # Node names repeat in a big subscription; the plugin needs the id of the node
        # carrying traffic now, to mark it in the list.
        "current_id": current_id,
        "fallback": fallback,
        "exit": exit_info(refresh_exit) if running else {},
        "traffic": {"today": today, "rate": rate},
        "subscriptions": sub_rows,
        "recent": recent_connections(names, rules=rules) if running else [],
        "rules": rules,
        "notify": notify_enabled(),
        # The sites to check and their last result; no network here.
        "sites": sites_status(),
        "presets": preset_state(),
        "network": network_status(),
        "errors": recent_errors() if running else [],
        "time": int(time.time()),
    }
    state["protection"] = protection(running, state["tun"], state["killswitch"], state["dns"], state["service"])
    # Settings or network values left out of the killswitch (not local networks).
    state["warnings"] = killswitch_args(network())[1]
    state["setup"] = setup_state()
    if with_nodes:
        state["nodes"] = node_table(nodes, m)
    return state


def setup_state():
    """What the tunnel needs installed: the root helper, the xray core with its
    capabilities and the geo files. ready only when all are there. version is
    this package's: the panel offers "Update components…" when it is older
    than the panel."""
    try:
        caps = bool(os.getxattr(os.path.realpath(XRAY), "security.capability"))
    except OSError:
        caps = False
    core = os.access(XRAY, os.X_OK)
    helper_ok = os.access(HELPER, os.X_OK)
    geo = all(os.path.exists(os.path.join(ASSET_DIR, n)) or os.path.exists(os.path.join(SYSTEM_GEO_DIR, n))
              for n in GEO_FILES)
    return {"version": VERSION, "helper": helper_ok, "core": core, "core_caps": caps, "geo": geo,
            "ready": helper_ok and core and caps and geo}


def human_bytes(n):
    n = float(n or 0)
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if n < 1024 or unit == "TB":
            return ("%.0f %s" if unit == "B" else "%.1f %s") % (n, unit)
        n /= 1024


