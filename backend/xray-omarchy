def cmd_rule(args):
    rules = load_rules()
    if args.action == "list":
        if args.json:
            print(json.dumps(rules, ensure_ascii=False))
        else:
            for side in ("direct", "tunnel"):
                for host in rules[side]:
                    print("%-7s %s" % (side, host))
        return 0
    if args.action == "add":
        if args.side not in ("direct", "tunnel") or not args.host:
            return finish(args, False, "usage", "", "usage: xray-omarchy rule add direct|tunnel HOST")
        host, _ = normalize_host(args.host)
        if not host:
            return finish(args, False, "invalid_host", args.host,
                          "not a domain or IPv4 address: %s" % args.host)
        for side in ("direct", "tunnel"):
            rules[side] = [h for h in rules[side] if h != host]
        rules[args.side].append(host)
        text = "rule: %s -> %s" % (host, args.side)
    else:
        host, _ = normalize_host(args.side)  # rm HOST: the host is the first argument
        if not host or not any(host in rules[s] for s in rules):
            return finish(args, False, "not_found", args.side or "", "no rule for %s" % args.side)
        for side in ("direct", "tunnel"):
            rules[side] = [h for h in rules[side] if h != host]
        text = "rule removed: %s" % host
    write_json(RULES_FILE, rules)
    cmd_build(None)
    if not service_active():
        return finish(args, True, "", host, text)
    subs, selection, sid, nodes = active_nodes()
    if not push_rules(selection, nodes):
        return finish(args, False, "apply_failed", host,
                      text + "; saved, but the running core did not accept the rules (applies on restart)")
    return finish(args, True, "", host, text + " (applied live)")


def cmd_notify(args):
    settings = read_json(SETTINGS_FILE, {})
    if args.action in ("on", "off"):
        settings["notify"] = args.action == "on"
        write_json(SETTINGS_FILE, settings)
    state = "on" if settings.get("notify", True) else "off"
    return finish(args, True, "", state, "notifications: %s" % state)


def preset_state(st=None):
    """{name: on} — a preset is on when all of its entries are in direct_geo."""
    geo = (st or load_settings())["direct_geo"]
    return {name: all(item in geo.get(key, []) for key, items in preset.items() for item in items)
            for name, preset in PRESETS.items()}


def cmd_preset(args):
    """Presets add their lists to direct_geo in settings.json or take them out.
    The DNS servers of the config change with them, so a running core picks
    the change up only on restart: --apply restarts it (the panel asks first)."""
    if args.name == "list":
        state = preset_state()
        if args.json:
            print(json.dumps(state))
        else:
            for name, on in state.items():
                print("%-10s %s" % (name, "on" if on else "off"))
        return 0
    if args.action not in ("on", "off"):
        return finish(args, False, "usage", "", "usage: xray-omarchy preset NAME on|off [--apply]")
    on = args.action == "on"
    raw = read_json(SETTINGS_FILE, {})
    raw = raw if isinstance(raw, dict) else {}
    geo = load_settings()["direct_geo"]
    for key, items in PRESETS[args.name].items():
        current = list(geo.get(key) or [])
        geo[key] = current + [i for i in items if i not in current] if on else [i for i in current if i not in items]
    raw["direct_geo"] = geo
    write_json(SETTINGS_FILE, raw)
    text = "preset %s: %s" % (args.name, args.action)
    cmd_build(None)
    if not service_active():
        return finish(args, True, "", args.action, text + " (core is not running, applies on start)")
    if args.apply:
        run(["systemctl", "--user", "restart", UNIT], timeout=60)
        return finish(args, True, "restarted", args.action, text + "; core restarted")
    return finish(args, True, "restart_needed", args.action,
                  text + "; applies on core restart: run again with --apply")


# ---------------------------------------------------------------- check sites

# A few sites the user wants to keep an eye on: does each one open, and which
# way does it go — through which node, direct by a preset or a rule, or direct
# because the tunnel is off. The check is one HTTPS request sent the way any
# program on this machine sends it, so it takes the same path; the path is
# then read back from the core's access log by the request's own local port.
SITE_MAX = 10
SITE_URL_MAX = 2000
# For all sites together (they run at once); a slow node gets the time a
# browser would give it.
SITE_TIMEOUT = 10
# The core writes the access log line as it dispatches the connection; a
# moment's grace for it to land.
SITE_LOG_WAIT = 1.5
SITE_EVERY = 60
# Failed checks in a row before "unreachable": one slow minute is not an outage.
SITE_CONFIRM = 3
# The request carries what an ordinary browser sends (Firefox on Linux), not
# this program's name: a site checked direct sees the user's real address, and
# must not learn from the request that a VPN client runs here.
SITE_UA = "Mozilla/5.0 (X11; Linux x86_64; rv:158.0) Gecko/20100101 Firefox/158.0"
SITE_HEADERS = ("Accept: text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8\r\n"
                "Accept-Language: en-US,en;q=0.5\r\n")
# The checks' own connections (local port, address, port, when), kept next to
# the core's log so `recent` can leave them out; only as long as the log holds
# lines that old.
SITE_PROBES = os.path.join(RUN_DIR, "site-probes.json")
SITE_PROBES_MAX = 5000
SITE_RESULT_KEYS = ("ok", "status", "ms", "error", "via", "node", "why", "source")
# Why a check failed, as codes (the panel words them); this is the terminal's text.
SITE_ERROR_TEXT = {
    "timeout": "no answer in %d s" % SITE_TIMEOUT,
    "dns_failed": "the name does not resolve",
    "refused": "connection refused",
    "reset": "connection reset",
    "tls_cert": "certificate check failed",
    "tls_failed": "TLS handshake failed",
    "unreachable": "network unreachable",
    "bad_answer": "not an HTTP answer",
    "http_status": "answered %s",
    "other": "failed",
}
SITE_URL_RE = re.compile(r"[\x21-\x7e]+")


def site_url(text):
    """An https link a check may open, as {url, host, port, target}, or None.
    One line of printable ASCII, at most 2000 characters, no user or password
    (nothing secret goes into a check), a host that is a domain or an IPv4
    address."""
    url = text.strip() if isinstance(text, str) else ""
    if not url or len(url) > SITE_URL_MAX or not SITE_URL_RE.fullmatch(url):
        return None
    try:
        parts = up.urlsplit(url)
        port = parts.port
    except ValueError:
        return None
    if parts.scheme.lower() != "https" or "@" in parts.netloc or not parts.hostname:
        return None
    host, _ = normalize_host(parts.hostname)
    if not host:
        return None
    target = parts.path or "/"
    if parts.query:
        target += "?" + parts.query
    return {"url": url, "host": host, "port": port or 443, "target": target}


def load_sites(raw=None):
    """check_sites from settings.json without junk: a usable name and link,
    one entry per name, at most SITE_MAX."""
    raw = read_json(SETTINGS_FILE, {}) if raw is None else raw
    items = raw.get("check_sites") if isinstance(raw, dict) else None
    out, seen = [], set()
    for item in items if isinstance(items, list) else []:
        if len(out) >= SITE_MAX or not isinstance(item, dict):
            continue
        name = item.get("name").strip() if isinstance(item.get("name"), str) else ""
        u = site_url(item.get("url"))
        if not SUB_NAME_RE.fullmatch(name) or u is None or name in seen:
            continue
        seen.add(name)
        out.append({"name": name, "url": u["url"]})
    return out


def site_notify_enabled(raw=None):
    raw = read_json(SETTINGS_FILE, {}) if raw is None else raw
    return bool(raw.get("site_notify", True)) if isinstance(raw, dict) else True


def route_from_log(lines, src_port, ip="", port=None):
    """The outbound the core gave one connection, found in its access log by the
    connection's local port (and its address and port, when known); the newest
    line wins. None when the log does not have it."""
    want = ":%d" % src_port
    for line in reversed(lines):
        a = ACCESS_RE.match(line)
        if not a:
            continue
        _ts, src, _proto, dest, dport, route = a.groups()
        if not route.startswith("tun") or not src.endswith(want):
            continue
        if (ip and dest.strip("[]") != ip) or (port and int(dport) != port):
            continue
        return DETOUR_RE.split(route.strip())[-1]
    return None


def log_size(path):
    try:
        return os.path.getsize(path)
    except OSError:
        return 0


def read_from(path, offset, max_bytes=2_000_000):
    """The lines a log gained since `offset` (a size taken earlier). A log that
    became shorter was trimmed in between: then all of it."""
    try:
        with open(path, "rb") as fh:
            fh.seek(0, 2)
            size = fh.tell()
            fh.seek(offset if offset <= size else 0)
            return fh.read(max_bytes).decode("utf8", "replace").splitlines()
    except OSError:
        return []


def log_time(ts):
    """A line's time in the core's log ("2026/11/19 16:07:24.605763", local) as epoch seconds."""
    try:
        return time.mktime(time.strptime(ts[:19], "%Y/%m/%d %H:%M:%S"))
    except (ValueError, OverflowError):
        return None


def first_log_time(path):
    try:
        with open(path, "rb") as fh:
            head = fh.read(4096).decode("utf8", "replace").splitlines()
    except OSError:
        return None
    for line in head:
        a = ACCESS_RE.match(line)
        if a:
            return log_time(a.group(1))
    return None


def remember_probes(started, boxes):
    """Notes the checks' own connections, so `recent` does not count them as the
    user's. Entries older than the log's first line can match nothing and go."""
    new = [[int(started), b["src_port"], b["ip"], b["port"]] for b in boxes if b.get("src_port") and b.get("ip")]
    if not new:
        return
    try:
        os.makedirs(RUN_DIR, mode=0o700, exist_ok=True)
        with open(SITE_PROBES + ".lock", "w") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            raw = read_json(SITE_PROBES, {})
            old = raw.get("probes") if isinstance(raw, dict) else None
            oldest = first_log_time(ACCESS_LOG)
            keep = [p for p in old or [] if isinstance(p, list) and len(p) == 4
                    and (oldest is None or p[0] >= oldest - SITE_TIMEOUT - 60)]
            write_json(SITE_PROBES, {"probes": (keep + new)[-SITE_PROBES_MAX:]})
    except OSError:
        pass


def load_probes():
    """{(local port, address, port): [start times]} of the checks' own connections."""
    raw = read_json(SITE_PROBES, {})
    out = {}
    for p in (raw.get("probes") if isinstance(raw, dict) else None) or []:
        if isinstance(p, list) and len(p) == 4:
            out.setdefault((p[1], p[2], p[3]), []).append(p[0])
    return out


def is_probe(probes, ts, src, ip, port):
    """Whether one access-log line is a site check's own connection: the same
    local port, address and port, within the check's time (ports are reused)."""
    if not probes:
        return False
    try:
        key = (int(src.rsplit(":", 1)[1]), ip, int(port))
    except (IndexError, ValueError):
        return False
    starts = probes.get(key)
    if not starts:
        return False
    t = log_time(ts)
    return t is not None and any(s - 2 <= t <= s + SITE_TIMEOUT + 3 for s in starts)


def _in_zones(host, zones):
    return any(host == z or host.endswith("." + z) for z in zones)


def site_local(host, ip, st):
    """What the config always sends direct: private and local addresses, LAN names."""
    if ip:
        try:
            if ipaddress.ip_address(ip).is_private or in_nets(ip, st["local_nets"]):
                return True
        except ValueError:
            pass
    return _in_zones(host, st["lan_domains"])


def site_path(host, ip, outbound, running, rules, st, names, current=""):
    """{via, node, why, source}: which way a check went. From the core's log when
    it holds the connection (source "log"); otherwise worked out from the rules
    (source "rules"): the tunnel off, a site rule, a local address or a direct
    zone, else the tunnel. geosite and geoip lists cannot be read here, so a
    site they send direct is only known from the log.
    why: "rule" (a site rule, rules.json), "local", "geo" (direct_geo: a preset
    or the user's own lists), "tunnel_off", or "" (the tunnel, by default)."""
    if not running:
        return {"via": "direct", "node": "", "why": "tunnel_off", "source": "rules"}
    rule = rule_for(host, ip, rules)
    if outbound:
        via = "direct" if outbound == "direct" else "block" if outbound == "block" else "tunnel"
        source = "log"
    else:
        source = "rules"
        if rule:
            via = rule
        elif site_local(host, ip, st) or _in_zones(host, st["direct_geo"]["domains"]):
            via = "direct"
        else:
            via = "tunnel"
    if rule == via:
        why = "rule"
    elif via == "direct":
        why = "local" if site_local(host, ip, st) else "geo"
    else:
        why = ""
    node = ""
    if via == "tunnel":
        node = names.get(outbound, outbound) if outbound else (current() if callable(current) else current)
    return {"via": via, "node": node or "", "why": why, "source": source}


def check_site(u, deadline, out, note=None):
    """One HTTPS GET to the site, as any program here sends it (through the
    tunnel while it runs), into `out`. A redirect is not followed: it is an
    answer, and the site opens. ok: an answer below 400. `note`, when given,
    is told the connection (out) before it is made, so that `recent` already
    knows it for the check's own while it runs."""
    start = time.monotonic()

    def left():
        rest = deadline - time.monotonic()
        if rest <= 0:
            raise TimeoutError()
        return rest

    try:
        # IPv4 only: the tunnel carries IPv4, and the killswitch refuses IPv6.
        info = socket.getaddrinfo(u["host"], u["port"], socket.AF_INET, socket.SOCK_STREAM)
        out["ip"] = info[0][4][0]
        # The local port is taken before connecting, so even a connection that
        # never completes can be found in the core's log.
        sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        try:
            sock.bind(("0.0.0.0", 0))
            out["src_port"] = sock.getsockname()[1]
            if note:
                note(dict(out, port=u["port"]))
            sock.settimeout(left())
            sock.connect((out["ip"], u["port"]))
            tls = ssl.create_default_context().wrap_socket(sock, server_hostname=u["host"])
        except BaseException:
            sock.close()
            raise
        with tls:
            tls.settimeout(left())
            host = u["host"] if u["port"] == 443 else "%s:%d" % (u["host"], u["port"])
            tls.sendall(("GET %s HTTP/1.1\r\nHost: %s\r\nUser-Agent: %s\r\n%sConnection: close\r\n\r\n"
                         % (u["target"], host, SITE_UA, SITE_HEADERS)).encode("ascii"))
            resp = http.client.HTTPResponse(tls, method="GET")
            resp.begin()
            out["status"] = resp.status
        out["ms"] = int((time.monotonic() - start) * 1000)
        out["ok"] = out["status"] < 400
        out["error"] = "" if out["ok"] else "http_status"
    except socket.gaierror:
        out["error"] = "dns_failed"
    except TimeoutError:
        out["error"] = "timeout"
    except ssl.SSLCertVerificationError:
        out["error"] = "tls_cert"
    except (ConnectionResetError, ConnectionAbortedError, BrokenPipeError, ssl.SSLEOFError,
            ssl.SSLZeroReturnError):
        out["error"] = "reset"
    except ssl.SSLError:
        out["error"] = "tls_failed"
    except ConnectionRefusedError:
        out["error"] = "refused"
    except http.client.HTTPException:
        out["error"] = "bad_answer"
    except OSError as error:
        out["error"] = "unreachable" if error.errno in (errno.ENETUNREACH, errno.EHOSTUNREACH) else "other"
    except Exception:
        out["error"] = "other"
    out["done"] = True
    return out


def run_site_checks(sites=None, write=True):
    """Checks every site at once (threads under one deadline: a name lookup has
    no timeout of its own), then reads the way each one went from the core's
    log. The result is kept in SITES_FILE for `status` and the panel."""
    sites = load_sites() if sites is None else sites
    running = service_active()
    # Where the core's log ends now: the checks' lines come after it.
    log_start = log_size(ACCESS_LOG) if running else 0
    started = time.time()
    deadline = time.monotonic() + SITE_TIMEOUT
    jobs = []
    # Each connection is noted as it is made, before the core logs it.
    note = (lambda b: remember_probes(started, [b])) if running else None
    for site in sites:
        u = site_url(site["url"])
        box = {"ok": False, "status": 0, "ms": None, "error": "", "ip": "", "src_port": 0, "done": False}
        thread = threading.Thread(target=check_site, args=(u, deadline, box, note), daemon=True)
        thread.start()
        jobs.append((site, u, box, thread))
    for _site, _u, _box, thread in jobs:
        thread.join(max(0.0, deadline + 0.5 - time.monotonic()))
    # A copy: a lookup that outlived the deadline may still write into its box.
    done = [(site, u, dict(box) if box["done"] else dict(box, error="timeout", ok=False))
            for site, u, box, _thread in jobs]

    routes = {}
    if running:
        wanted = [(i, b) for i, (_s, _u, b) in enumerate(done) if b["src_port"]]
        stop = time.monotonic() + SITE_LOG_WAIT
        while wanted:
            lines = read_from(ACCESS_LOG, log_start)
            for i, b in wanted:
                if i not in routes:
                    found = route_from_log(lines, b["src_port"], b["ip"], done[i][1]["port"])
                    if found:
                        routes[i] = found
            if len(routes) == len(wanted) or time.monotonic() >= stop:
                break
            time.sleep(0.1)

    names, cache = {}, {}
    subs, selection, sid, nodes = active_nodes() if running else ([], {}, None, [])
    for n in nodes:
        for o in n["outbounds"]:
            names[o["tag"]] = n["name"]

    def current():
        # Only for a check the log does not hold: the node the tunnel uses now.
        if "node" not in cache:
            _, chosen = target_for(selection, nodes) if nodes else (None, None)
            if chosen:
                cache["node"] = chosen["name"]
            else:
                _, pick = balancer_pick("auto")
                cache["node"] = names.get(pick, pick or "")
        return cache["node"]

    rules, st = load_rules(), load_settings()
    results = []
    for i, (site, u, box) in enumerate(done):
        path = site_path(u["host"], box["ip"], routes.get(i), running, rules, st, names, current)
        results.append(dict({"name": site["name"], "url": u["url"], "host": u["host"], "ok": box["ok"],
                             "status": box["status"] or None, "ms": box["ms"],
                             "error": box["error"] if not box["ok"] else ""}, **path))
    state = {"time": int(time.time()), "tunnel": running, "results": results}
    if write:
        write_json(SITES_FILE, state)
    return state


def sites_status(raw=None):
    """For `status`: the sites with the last result of each (from the last
    check, the watcher's or the panel's), no network."""
    raw = read_json(SETTINGS_FILE, {}) if raw is None else raw
    cache = read_json(SITES_FILE, {})
    cache = cache if isinstance(cache, dict) else {}
    last = {(r.get("name"), r.get("url")): r for r in cache.get("results") or [] if isinstance(r, dict)}
    items = []
    for s in load_sites(raw):
        r = last.get((s["name"], s["url"]))
        items.append({"name": s["name"], "host": site_url(s["url"])["host"],
                      "result": {k: r.get(k) for k in SITE_RESULT_KEYS} if r else None})
    return {"items": items, "checked": cache.get("time"), "tunnel": cache.get("tunnel"),
            "notify": site_notify_enabled(raw)}


def site_way(r):
    """Which way a result went, in words for a notification or a terminal."""
    if r.get("why") == "tunnel_off":
        return "direct, tunnel off"
    if r.get("via") == "tunnel":
        return "via " + r["node"] if r.get("node") else "via the tunnel"
    if r.get("via") == "block":
        return "blocked"
    return "direct by rule" if r.get("why") == "rule" else "direct"


def site_error_text(r):
    text = SITE_ERROR_TEXT.get(r.get("error") or "other", SITE_ERROR_TEXT["other"])
    return text % (r.get("status") or "?") if "%s" in text else text


def cmd_site(args):
    raw = read_json(SETTINGS_FILE, {})
    raw = raw if isinstance(raw, dict) else {}
    sites = load_sites(raw)
    if args.action == "list":
        if args.json:
            print(json.dumps(sites, ensure_ascii=False))
        else:
            for s in sites:
                print("%-20s %s" % (s["name"], s["url"]))
            if not sites:
                print("no sites: xray-omarchy site add NAME URL")
        return 0
    if args.action == "add":
        if not args.name or not args.url:
            return finish(args, False, "usage", "", "usage: xray-omarchy site add NAME URL")
        name = args.name.strip()
        if not SUB_NAME_RE.fullmatch(name):
            return finish(args, False, "invalid_name", "",
                          "site name: 1-40 characters, no control characters, not starting with -")
        url = args.url.strip()
        if url.lower().startswith("http://"):
            return finish(args, False, "insecure_url", "", "not added: only https links are checked")
        u = site_url(url)
        if u is None:
            return finish(args, False, "invalid_url", "",
                          "not added: one https link to a domain or an IPv4 address, no spaces, no user or "
                          "password, at most %d characters" % SITE_URL_MAX)
        at = [i for i, s in enumerate(sites) if s["name"] == name]
        if not at and len(sites) >= SITE_MAX:
            return finish(args, False, "too_many", str(SITE_MAX), "not added: at most %d sites" % SITE_MAX)
        entry = {"name": name, "url": u["url"]}
        if at:
            sites[at[0]] = entry
        else:
            sites.append(entry)
        raw["check_sites"] = sites
        write_json(SETTINGS_FILE, raw)
        return finish(args, True, "replaced" if at else "", name,
                      "site %s %s: %s" % (name, "replaced" if at else "added", u["url"]))
    if args.action == "rm":
        name = (args.name or "").strip()
        left = [s for s in sites if s["name"] != name]
        if not name or len(left) == len(sites):
            return finish(args, False, "not_found", name, "no site %s" % name)
        raw["check_sites"] = left
        write_json(SETTINGS_FILE, raw)
        return finish(args, True, "", name, "site %s removed" % name)
    if args.action == "notify":
        if args.name in ("on", "off"):
            raw["site_notify"] = args.name == "on"
            write_json(SETTINGS_FILE, raw)
        elif args.name:
            return finish(args, False, "usage", "", "usage: xray-omarchy site notify on|off")
        state = "on" if site_notify_enabled(raw) else "off"
        return finish(args, True, "", state, "site notifications: %s" % state)
    # check
    result = run_site_checks(sites)
    if args.json:
        print(json.dumps(result, ensure_ascii=False))
        return 0
    if not sites:
        print("no sites: xray-omarchy site add NAME URL")
    for r in result["results"]:
        print("%-20s %-4s %-28s %s%s" % (
            r["name"], "ok" if r["ok"] else "FAIL",
            ("%d ms" % r["ms"] if r["ok"] and r["ms"] is not None else site_error_text(r)),
            site_way(r), "" if r["source"] == "log" or r["why"] == "tunnel_off" else " (from the rules)"))
    return 0


# ---------------------------------------------------------------- notifications

WATCH_INTERVAL = 10
KILLSWITCH_EVERY = 30  # the helper less often: every sudo call is lines in the journal
DAY = 86400


def markup_escape(text):
    return (text or "").replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")


def send_notification(summary, body, urgency="normal"):
    """notify-send with app-name xray-omarchy. Foreign strings only as arguments,
    with markup escaped in the text."""
    r = subprocess.run(["notify-send", "-a", "xray-omarchy", "-u", urgency, "--",
                        summary, markup_escape(body)],
                       capture_output=True, text=True, timeout=10)
    log("notify (%s): %s | %s%s" % (urgency, summary, body, "" if r.returncode == 0 else " [failed]"))
    return r.returncode == 0


_ks_cache = {"t": 0, "v": "unknown"}


def watch_snapshot():
    """A narrow poll for watch: no exit address, no traffic accounting, no log."""
    subs, selection, sid, nodes = active_nodes()
    running = service_active()
    tun = os.path.exists("/sys/class/net/" + DEV)
    if time.time() - _ks_cache["t"] >= KILLSWITCH_EVERY:
        _ks_cache.update(t=time.time(), v=killswitch_state())
    prot = protection(running, tun, _ks_cache["v"], dns_state())
    m = metrics() if running else None
    obs = (m or {}).get("observatory") or {}
    by_id = {n["id"]: n for n in nodes}
    node = None
    if selection.get("mode") == "node" and selection.get("node") in by_id:
        n = by_id[selection["node"]]
        node = {"id": n["id"], "name": n["name"], "alive": node_alive(n, obs) if running else None}
    fb = fallback_status(selection, nodes, running, with_restart=False) if running \
        else {"ready": False, "active": None}
    fb_node = (selection.get("fallback") or {}).get("node")
    sub_rows = []
    for s in subs:
        meta = read_json(os.path.join(SUBS_CACHE, sub_id(s) + ".meta.json"), {})
        ui = meta.get("userinfo") or {}
        sub_rows.append({"name": s["name"], "expire": ui.get("expire", 0),
                         "used": ui.get("upload", 0) + ui.get("download", 0), "total": ui.get("total", 0)})
    return {"time": int(time.time()), "running": running,
            "protection": {"ok": prot["ok"], "codes": prot["codes"]},
            "node": node,
            "fallback": {"ready": bool(fb.get("ready")), "active": fb.get("active"),
                         "node_name": by_id[fb_node]["name"] if fb_node in by_id else None},
            "subscriptions": sub_rows}


def watch_events(snap, memory, daily, confirm):
    """Compare a snapshot with memory; return events (code, urgency, summary, body).
    Memory is what was already reported: one notification per change of state."""
    events = []
    now = snap.get("time") or int(time.time())

    # Protection. A bad state must last `confirm` polls in a row: while the core
    # starts and stops, protection is honestly incomplete for a second or two.
    prot = snap.get("protection") or {}
    if prot.get("ok", True):
        memory["prot_streak"] = 0
        if memory.get("protection") == "lost":
            events.append(("protection_restored", "normal", "VPN protection restored",
                           "Traffic goes through the tunnel again."))
        memory["protection"] = "ok"
    else:
        memory["prot_streak"] = memory.get("prot_streak", 0) + 1
        if memory["prot_streak"] >= confirm and memory.get("protection") != "lost":
            text = ", ".join(PROTECTION_TEXT.get(c, c) for c in prot.get("codes") or [])
            events.append(("protection_lost", "critical", "VPN protection lost", text + "."))
            memory["protection"] = "lost"

    # The selected node. Not probed (None): unknown, change nothing.
    node = snap.get("node")
    if node:
        if memory.get("node_id") != node.get("id"):
            memory.update(node_id=node.get("id"), node_state="alive", node_streak=0)
        alive = node.get("alive")
        if alive is True:
            memory["node_streak"] = 0
            if memory.get("node_state") == "dead":
                events.append(("node_up", "normal", "VPN node is back", "%s answers again." % node["name"]))
            memory["node_state"] = "alive"
        elif alive is False:
            memory["node_streak"] = memory.get("node_streak", 0) + 1
            if memory["node_streak"] >= confirm and memory.get("node_state") != "dead":
                events.append(("node_down", "normal", "VPN node is down",
                               "%s does not answer health checks." % node["name"]))
                memory["node_state"] = "dead"
    else:
        memory.update(node_id=None, node_state="alive", node_streak=0)

    # Fallback node. Right after a start the core has not probed the primary yet and
    # honestly sends traffic to the fallback; that is not an event, so `confirm` polls here too.
    fb = snap.get("fallback") or {}
    if fb.get("ready") and fb.get("active") is not None:
        memory["fb_streak"] = memory.get("fb_streak", 0) + 1 if fb["active"] else 0
        if fb["active"] and memory["fb_streak"] >= confirm and memory.get("fallback") != "active":
            events.append(("fallback_engaged", "normal", "Switched to fallback node",
                           "%s is down, traffic goes via %s." % ((node or {}).get("name") or "Selected node",
                                                                 fb.get("node_name") or "the fallback node")))
            memory["fallback"] = "active"
        elif not fb["active"] and memory.get("fallback") == "active":
            events.append(("primary_restored", "normal", "Back on primary node",
                           "Traffic goes via %s again." % ((node or {}).get("name") or "the selected node")))
            memory["fallback"] = "idle"
    elif not fb.get("ready"):
        memory.update(fallback="idle", fb_streak=0)

    # Subscriptions: at most once a day per subscription and event.
    for s in snap.get("subscriptions") or []:
        name = s.get("name") or "?"
        expire = s.get("expire") or 0
        if expire > 0 and expire - now <= 3 * DAY and now - daily.get("expire:" + name, 0) >= DAY:
            when = time.strftime("%Y-%m-%d", time.localtime(expire))
            left = expire - now
            body = ("%s expired on %s." % (name, when) if left <= 0 else
                    "%s expires in %s (%s)." % (name, "%d h" % max(1, left // 3600) if left < DAY
                                                else "%d days" % (left // DAY), when))
            events.append(("sub_expiring", "normal", "Subscription expires soon", body))
            daily["expire:" + name] = now
        total, used = s.get("total") or 0, s.get("used") or 0
        if total > 0 and used >= 0.9 * total and now - daily.get("traffic:" + name, 0) >= DAY:
            events.append(("sub_traffic", "normal", "Subscription traffic almost used",
                           "%s: %s of %s used (%d%%)." % (name, human_bytes(used), human_bytes(total),
                                                         100 * used // total)))
            daily["traffic:" + name] = now

    # Checked sites, only on the polls that carry a fresh check: SITE_CONFIRM
    # failed checks in a row before "unreachable", one good one for "back", and
    # one notification per change. The way named is this check's own: from the
    # core's log, or from a rule, a local address or a direct zone; a failure
    # the log does not hold and nothing decides (the name did not resolve, say)
    # took no way, and says so.
    if "sites" in snap:
        mem = memory.setdefault("sites", {})
        seen = set()
        for r in snap.get("sites") or []:
            if not isinstance(r, dict) or not isinstance(r.get("name"), str) or not r["name"]:
                continue
            name = r["name"]
            seen.add(name)
            m = mem.setdefault(name, {"state": "ok", "streak": 0})
            m.pop("way", None)
            if r.get("ok"):
                if m.get("state") == "down":
                    events.append(("site_up", "normal", "Site is back: %s (%s)" % (name, site_way(r)),
                                   "It answers again, in %s ms." % (r.get("ms") if r.get("ms") is not None else "?")))
                m.update(state="ok", streak=0)
            else:
                m["streak"] = m.get("streak", 0) + 1
                if m["streak"] >= SITE_CONFIRM and m.get("state") != "down":
                    known = r.get("source") == "log" or r.get("why") or r.get("via") != "tunnel"
                    text = site_error_text(r)
                    events.append(("site_down", "normal", "Site unreachable: %s (%s)"
                                   % (name, site_way(r) if known else "way unknown"),
                                   "%s, %d checks in a row." % (text[:1].upper() + text[1:], SITE_CONFIRM)))
                    m["state"] = "down"
        for name in [k for k in mem if k not in seen]:
            del mem[name]
    return events


def cmd_watch(args):
    fake = args.state_file is not None
    # A test run (--state-file) keeps its memory next to the fake state and leaves the real one alone.
    mem_path = args.memory or (args.state_file + ".memory.json" if fake else WATCH_FILE)
    daily_path = mem_path if fake else WATCH_DAILY
    confirm = 1 if fake else 2
    # Sites are checked once a minute in a thread of their own, so a slow site
    # never holds up the protection checks; the next poll carries the result.
    sites = {"thread": None, "result": None, "last": 0.0}

    def check_sites():
        try:
            sites["result"] = run_site_checks()
        except Exception as error:
            log("watch: site check: %s" % error)

    while True:
        try:
            snap = read_json(args.state_file, None) if fake else watch_snapshot()
            if snap is None:
                raise ValueError("cannot read state file %s" % args.state_file)
            if not fake:
                if args.once and load_sites():
                    check_sites()
                if sites["result"] is not None:
                    snap["sites"] = sites["result"]["results"]
                    sites["result"] = None
                elif not args.once and time.time() - sites["last"] >= SITE_EVERY and load_sites() \
                        and not (sites["thread"] and sites["thread"].is_alive()):
                    sites["last"] = time.time()
                    sites["thread"] = threading.Thread(target=check_sites, daemon=True)
                    sites["thread"].start()
            memory = read_json(mem_path, {})
            daily = read_json(daily_path, {}) if not fake else memory.setdefault("daily", {})
            events = watch_events(snap, memory, daily, confirm)
            sent = []
            enabled = notify_enabled()
            site_alerts = site_notify_enabled()
            for code, urgency, summary, body in events:
                allowed = enabled and (site_alerts or not code.startswith("site_"))
                ok = send_notification(summary, body, urgency) if allowed else False
                sent.append({"event": code, "urgency": urgency, "summary": summary, "body": body,
                             "sent": ok})
            write_json(mem_path, memory)
            if not fake:
                write_json(daily_path, daily)
            if args.once:
                if args.json:
                    print(json.dumps({"events": sent, "notify": enabled}, ensure_ascii=False))
                else:
                    for e in sent:
                        print("%s: %s | %s%s" % (e["event"], e["summary"], e["body"],
                                                 "" if e["sent"] else " (not sent)"))
                    if not sent:
                        print("no events")
                return 0
        except Exception as error:
            if args.once:
                print("watch failed: %s" % error, file=sys.stderr)
                return 1
            log("watch: %s" % error)
        time.sleep(WATCH_INTERVAL)


# ---------------------------------------------------------------- xray core: update

CORE_CODES = ("ok", "up_to_date", "download_failed", "checksum_mismatch", "config_rejected",
              "stage_failed", "stage_busy", "no_space", "not_pinned", "rolled_back", "started", "in_progress",
              "check_failed")
SHA256_RE = re.compile(r"[0-9a-f]{64}")


def version_tuple(text):
    return tuple(int(x) for x in re.findall(r"\d+", text or "")[:4])


def xray_version(binary=None):
    try:
        out = run([binary or XRAY, "version"], timeout=15).stdout
    except (OSError, subprocess.TimeoutExpired):
        return None
    m = re.search(r"Xray (\d+(?:\.\d+)+)", out)
    return m.group(1) if m else None


def http_get(url, limit, timeout=60):
    req = urllib.request.Request(url, headers={"User-Agent": "xray-omarchy", "Accept": "application/vnd.github+json"})
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        return read_limited(resp, limit)


def check_release_url(url):
    """A core comes only from XTLS's own releases. GitHub redirects the download
    to its file host; the link asked for must be this one."""
    if not isinstance(url, str) or not url.startswith(RELEASE_DOWNLOAD) \
            or re.search(r"[^\x21-\x7e]|\.\.|[?#]", url):
        raise ValueError("not an XTLS release link: %r" % str(url)[:120])
    return url


def release_version(tag):
    """The version from a release tag (v26.11.9), checked before it is used anywhere."""
    m = TAG_RE.fullmatch(tag) if isinstance(tag, str) else None
    if not m:
        raise ValueError("unexpected release tag %r" % str(tag)[:40])
    return m.group(1)


def pinned_versions():
    """{version: SHA-256 of the zip} this package pins for this machine."""
    data = read_json(CORE_SUMS, {})
    versions = data.get("versions") if isinstance(data, dict) else None
    arch = platform.machine()
    out = {}
    for ver, entry in (versions.items() if isinstance(versions, dict) else []):
        sha = entry.get(arch) if isinstance(entry, dict) else None
        if isinstance(ver, str) and TAG_RE.fullmatch(ver) and not ver.startswith("v") \
                and isinstance(sha, str) and SHA256_RE.fullmatch(sha):
            out[ver] = sha
    return out


def newest_pinned(pins=None):
    pins = pinned_versions() if pins is None else pins
    return max(pins, key=version_tuple) if pins else None


def core_url(version):
    return check_release_url("%sv%s/%s" % (RELEASE_DOWNLOAD, version, RELEASE_ASSET))


def latest_release(refresh=False):
    """The newest XTLS release, cached for a day (the API allows 60 requests an
    hour). For information only: `core update` installs the newest pinned one."""
    state = read_json(CORE_STATE, {})
    latest = state.get("latest") or {}
    if not refresh and latest.get("version") and time.time() - latest.get("checked", 0) < DAY:
        return latest, None
    try:
        data = json.loads(http_get(RELEASE_API, API_MAX, timeout=20))
        if not isinstance(data, dict):
            raise ValueError("unexpected answer from the release API")
        version = release_version(data.get("tag_name"))
        assets = {a.get("name"): a.get("browser_download_url")
                  for a in data.get("assets") or [] if isinstance(a, dict)}
        if RELEASE_ASSET not in assets:
            raise ValueError("release %s has no %s" % (version, RELEASE_ASSET))
        check_release_url(assets[RELEASE_ASSET])
        published = data.get("published_at")
        latest = {"version": version,
                  "published": published if isinstance(published, str) and len(published) <= 40 else None,
                  "checked": int(time.time())}
        state = read_json(CORE_STATE, {})
        state["latest"] = latest
        state.pop("check_error", None)
        write_json(CORE_STATE, state)
        return latest, None
    except Exception as error:
        state = read_json(CORE_STATE, {})
        state["check_error"] = str(error)[:200]
        state.pop("latest", None)
        write_json(CORE_STATE, state)
        return None, str(error)[:200]


def update_running():
    return run(["systemctl", "--user", "is-active", "--quiet", CORE_UPDATE_UNIT + ".service"]).returncode == 0


def core_status_data(refresh=False):
    current = xray_version()
    pins = pinned_versions()
    target = newest_pinned(pins)
    latest, error = latest_release(refresh)
    state = read_json(CORE_STATE, {})
    update = state.get("update")
    if update and update.get("state") == "running" and not update_running() \
            and time.time() - update.get("started", 0) > 300:
        update = dict(update, state="lost")  # the detached process vanished without a result
    release = (latest or {}).get("version")
    available = None
    if target:
        available = version_tuple(target) > version_tuple(current) if current else True
    return {"version": current, "path": XRAY,
            # What can be installed: the newest version this package pins.
            "latest": target, "pinned": sorted(pins, key=version_tuple, reverse=True),
            "latest_published": (latest or {}).get("published") if release == target else None,
            "latest_checked": (latest or {}).get("checked"),
            # The newest XTLS release; newer than "latest" means it comes with a package update.
            "release": release,
            "release_pinned": (release in pins) if release else None,
            "update_available": available,
            "check_error": error,
            "prev": os.path.exists(XRAY_PREV),
            "prev_version": xray_version(XRAY_PREV) if os.path.exists(XRAY_PREV) else None,
            "in_progress": bool(update and update.get("state") == "running"),
            "update": update}


def record_update(**fields):
    state = read_json(CORE_STATE, {})
    update = state.get("update") or {}
    update.update(fields)
    state["update"] = update
    write_json(CORE_STATE, state)
    return update


def core_result(args, ok, code, detail, text, **extra):
    say(text)
    if getattr(args, "json", False):
        print(json.dumps(dict({"ok": ok, "code": code, "detail": detail}, **extra), ensure_ascii=False))
    return 0 if ok else 1


def file_sha256(path):
    h = hashlib.sha256()
    with open(path, "rb") as fh:
        for chunk in iter(lambda: fh.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def core_download(version, sha):
    """The pinned zip of VERSION in the cache, downloaded unless a copy with the
    pinned sum is already there. (path, code, detail)."""
    folder = os.path.join(CORE_CACHE, version)
    path = os.path.join(folder, RELEASE_ASSET)
    try:
        if os.path.isfile(path) and not os.path.islink(path) and file_sha256(path) == sha:
            return path, "", "cached"
    except OSError:
        pass
    try:
        data = http_get(core_url(version), CORE_ZIP_MAX, timeout=300)
    except Exception as error:
        return None, "download_failed", str(error)[:200]
    got = hashlib.sha256(data).hexdigest()
    if got != sha:
        return None, "checksum_mismatch", "expected %s, got %s" % (sha, got)
    os.makedirs(folder, mode=0o700, exist_ok=True)
    write_private(path, data, binary=True)
    return path, "", "downloaded"


def core_stage(version, sha):
    """Download (as this user), then the helper copies the zip into root's
    directory, checks the pinned SHA-256 on its copy and takes the binary out.
    (code, detail): code "" when staged."""
    path, code, detail = core_download(version, sha)
    if code:
        return code, detail
    r = helper("core", "stage", version, path)
    if r.returncode in (3, 5, 6):
        # 3: the sum does not match; 5: another stage is running; 6: no free space.
        return ({3: "checksum_mismatch", 5: "stage_busy", 6: "no_space"}[r.returncode],
                (r.stderr.strip() or r.stdout.strip())[:200])
    if r.returncode != 0:
        return "stage_failed", (r.stderr.strip() or r.stdout.strip())[:200]
    return "", detail


def staged_binary(version):
    return os.path.join(CORE_DIR, version, "xray")


def core_caps_ok(path=None):
    caps = run(["getcap", os.path.realpath(path or XRAY)]).stdout
    return "cap_net_admin" in caps and "cap_net_bind_service" in caps


def cmd_core(args):
    if args.action == "status":
        data = core_status_data(refresh=args.refresh)
        if args.json:
            print(json.dumps(data, ensure_ascii=False))
        else:
            print("xray:        %s (%s)" % (data["version"] or "not installed", data["path"]))
            print("installable: %s%s (pinned: %s)" % (data["latest"] or "none",
                                                      ", update available" if data["update_available"] else "",
                                                      ", ".join(data["pinned"]) or "none"))
            print("release:     %s%s" % (data["release"] or "unknown",
                                         ", not pinned yet: comes with a package update"
                                         if data["release_pinned"] is False else ""))
            if data["check_error"]:
                print("check error: %s" % data["check_error"])
            u = data["update"]
            if u:
                print("last update: %s %s -> %s: %s %s" % (u.get("state"), u.get("from"), u.get("to"),
                                                           u.get("code") or "", u.get("detail") or ""))
        return 0
    if args.action == "install":
        return core_install(args)
    # update
    if update_running():
        return core_result(args, False, "in_progress", "", "a core update is already running")
    current = xray_version()
    pins = pinned_versions()
    if not pins:
        return core_result(args, False, "check_failed", CORE_SUMS,
                           "no pinned xray versions for %s in %s" % (platform.machine(), CORE_SUMS))
    if args.to:
        m = TAG_RE.fullmatch(args.to)
        target = m.group(1) if m else None
        if target not in pins:
            return core_result(args, False, "not_pinned", str(args.to)[:40],
                               "xray %s is not pinned by this package (pinned: %s)" % (
                                   str(args.to)[:40], ", ".join(sorted(pins, key=version_tuple, reverse=True))),
                               version=current, latest=newest_pinned(pins))
    else:
        target = newest_pinned(pins)
    latest, _ = latest_release(refresh=True)
    release = (latest or {}).get("version")
    if not args.to and current and version_tuple(target) <= version_tuple(current) and not args.force:
        if release and version_tuple(release) > version_tuple(current):
            # A newer release exists, but no sum for it ships with this package.
            return core_result(args, False, "not_pinned", release,
                               "xray %s is out, but this package pins up to %s: update the package "
                               "(the panel's Update components…)" % (release, target),
                               version=current, latest=target, release=release)
        return core_result(args, True, "up_to_date", current, "xray %s is the latest" % current,
                           version=current, latest=target)
    code, detail = core_stage(target, pins[target])
    if code:
        return core_result(args, False, code, detail, "update failed (%s): %s" % (code, detail),
                           version=current, latest=target)
    binary = staged_binary(target)
    # No config yet (first install): nothing for the new core to reject.
    ok, err = xray_test(CONFIG_FILE, binary=binary) if os.path.exists(CONFIG_FILE) else (True, "")
    if not ok:
        return core_result(args, False, "config_rejected", err,
                           "xray %s rejects the current config: %s" % (target, err),
                           version=current, latest=target)
    if args.dry_run:
        return core_result(args, True, "ok", "verified, not activated (dry run)",
                           "xray %s staged in %s, sha256 %s pinned and matching, config OK (dry run)" % (
                               target, os.path.dirname(binary), pins[target][:16]),
                           dry_run=True, version=current, latest=target, staged=binary, sha256=pins[target])
    if not os.path.exists(XRAY):
        return core_first_install(args, target, pins[target])
    if current == target:
        # The same version again (lost capabilities, say): the helper set them
        # anew on the file in place; nothing to switch or restart.
        ok = core_caps_ok()
        return core_result(args, ok, "ok" if ok else "stage_failed", "reinstalled" if ok else "no capabilities",
                           "xray %s reinstalled in place%s" % (target, "" if ok else ", but without capabilities"),
                           version=current, latest=target)
    # Restarting the core cuts the connection: a detached service does the swap, the result goes to core.json.
    record_update(state="running", code="", ok=None, detail="", started=int(time.time()), finished=None,
                  **{"from": current, "to": target})
    env_args = []
    for key, value in os.environ.items():
        if key.startswith("XRAY_OMARCHY_"):
            env_args += ["-E", "%s=%s" % (key, value)]
    r = run(["systemd-run", "--user", "--quiet", "--collect", "--unit=" + CORE_UPDATE_UNIT, *env_args,
             os.path.abspath(__file__), "core", "install", target, "--from-version", current or ""])
    if r.returncode != 0:
        record_update(state="done", ok=False, code="in_progress", detail=r.stderr.strip()[:200],
                      finished=int(time.time()))
        return core_result(args, False, "in_progress", r.stderr.strip()[:200], "cannot start the update job")
    return core_result(args, True, "started", "see xray-omarchy core status",
                       "installing xray %s in the background (unit %s); result: xray-omarchy core status" % (
                           target, CORE_UPDATE_UNIT),
                       version=current, latest=target)


def core_first_install(args, version, sha):
    """No core yet: nothing runs and nothing to roll back to, so the staged core
    becomes the current one right here, without the detached unit."""
    r = helper("core", "activate", version)
    ok = r.returncode == 0 and core_caps_ok()
    why = "" if ok else ((r.stderr.strip() or r.stdout.strip() or "no capabilities on %s" % XRAY)[:200])
    now = int(time.time())
    record_update(state="done", ok=ok, code="ok" if ok else "stage_failed", detail=why,
                  started=now, finished=now, **{"from": None, "to": version})
    if not ok:
        return core_result(args, False, "stage_failed", why, "xray %s was not activated: %s" % (version, why),
                           version=xray_version(), latest=version)
    return core_result(args, True, "ok", "installed",
                       "xray %s installed to %s (zip sha256 %s, pinned), capabilities set" % (
                           version, os.path.dirname(os.path.realpath(XRAY)), sha[:16]),
                       version=version, latest=version, sha256=sha)


def core_health(deadline=20):
    """The service is active, xray-omarchy0 exists, ip rule 9110 is set, 204 from generate_204."""
    end = time.time() + deadline
    why = "not checked"
    while time.time() < end:
        if not service_active():
            why = "service not active"
        elif not CORE_PROXY and not os.path.exists("/sys/class/net/" + DEV):
            why = "no device " + DEV
        elif not CORE_PROXY and "%d:" % PREF_TUN not in run(["ip", "rule"]).stdout:
            why = "no ip rule %d" % PREF_TUN
        else:
            cmd = ["curl", "-s", "-o", "/dev/null", "-m", "5", "-w", "%{http_code}", PROBE_URL]
            if CORE_PROXY:
                cmd[1:1] = ["--proxy", CORE_PROXY]
            try:
                code = run(cmd, timeout=8).stdout.strip()
            except subprocess.TimeoutExpired:
                code = "timeout"
            if code == "204":
                return True, ""
            why = "probe answered %s" % (code or "nothing")
        time.sleep(1)
    return False, why


def core_install(args):
    """The detached part of an update: switch current, restart, health check, rollback.
    The helper keeps the previous version (core/previous) until the next update."""
    m = TAG_RE.fullmatch(args.target or "")
    if not m:
        return core_result(args, False, "stage_failed", "bad version", "bad version: %r" % args.target)
    to_ver = m.group(1)
    from_ver = args.from_version or xray_version()

    def done(ok, code, detail, text):
        record_update(state="done", ok=ok, code=code, detail=detail, finished=int(time.time()),
                      **{"from": from_ver, "to": to_ver})
        return core_result(args, ok, code, detail, text)

    record_update(state="running", started=int(time.time()), code="", ok=None, detail="",
                  **{"from": from_ver, "to": to_ver})
    r = helper("core", "activate", to_ver)
    if r.returncode != 0:
        why = (r.stderr.strip() or r.stdout.strip())[:200]
        return done(False, "stage_failed", why, "xray %s was not activated (%s)" % (to_ver, why))
    run(["systemctl", "--user", "restart", UNIT], timeout=60)
    healthy, why = core_health()
    if healthy:
        return done(True, "ok", "", "xray %s installed, tunnel is healthy" % to_ver)
    back = False
    why_back = "no previous version"
    # Back to what the helper kept as previous: the version that ran before.
    prev = os.path.basename(os.path.dirname(os.path.realpath(XRAY_PREV))) if os.path.exists(XRAY_PREV) else ""
    prev = prev if TAG_RE.fullmatch(prev) and prev != to_ver else ""
    if prev:
        # rollback, not activate: core/previous then points to the version that
        # ran before prev, not to the one that just failed.
        if helper("core", "rollback", prev).returncode == 0:
            from_ver = prev
            run(["systemctl", "--user", "restart", UNIT], timeout=60)
            back, why_back = core_health()
        else:
            why_back = "previous version not accepted"
    detail = "new core: %s; rollback: %s" % (why, "healthy" if back else why_back)
    return done(False, "rolled_back", detail, "xray %s failed (%s), rolled back to %s" % (to_ver, why, from_ver))


